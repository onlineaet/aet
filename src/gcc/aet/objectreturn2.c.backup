ObjectReturn *object_return_get()
{
	static ObjectReturn *singleton = NULL;
	if (!singleton){
		 singleton =n_slice_alloc0 (sizeof(ObjectReturn));
		 objectReturnlInit(singleton);
	}
	return singleton;
}



