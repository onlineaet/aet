static nboolean isClass(tree value)
{
	  char *sysName=class_util_get_class_name(TREE_TYPE(value));
	  return (sysName!=NULL && TREE_CODE(TREE_TYPE(value))==RECORD_TYPE);
}

static void copy_statement_list (tree *tp,tree declExpr)
{
  tree_stmt_iterator oi, ni;
  tree new_tree;
  tree var=DECL_EXPR_DECL (declExpr);
  new_tree = alloc_stmt_list ();
  ni = tsi_start (new_tree);
  oi = tsi_start (*tp);
  TREE_TYPE (new_tree) = TREE_TYPE (*tp);
  tree currentStmt = *tp;

  *tp = new_tree;
  tree tryFinally=setClearup(var);
  int count=0;
 // if(5>3)
	 // return;
  for (; !tsi_end_p (oi); tsi_next (&oi))
    {
      tree stmt = tsi_stmt (oi);
      printf("打印语句--- %d\n",count++);
      aet_print_tree_skip_debug(stmt);
      if (TREE_CODE (stmt) == STATEMENT_LIST)
	/* This copy is not redundant; tsi_link_after will smash this
	   STATEMENT_LIST into the end of the one we're building, and we
	   don't want to do that with the original.  */
	copy_statement_list (&stmt,declExpr);
      tsi_link_after (&ni, stmt, TSI_CONTINUE_LINKING);
      if(stmt==declExpr){
//    	 	  printf("vvv ssss 00000\n");
//    	 	  aet_print_tree_skip_debug(currentStmt);
//    	 	  printf("vvv ssss 11111\n");
//    	 	  tree  stmt_expr = STATEMENT_LIST_STMT_EXPR (currentStmt);
//    	 	  aet_print_tree_skip_debug(stmt_expr);
//    	 	  append_to_statement_list_force (tryFinally, &currentStmt);
//
//    	 	  tree list = alloc_stmt_list ();
//
//    	 	  //tree  list = stmtList;
//    	 	  TREE_OPERAND (tryFinally, 0) = list;
//    	 	  STATEMENT_LIST_STMT_EXPR (list) = stmt_expr;


            //tsi_link_after (&ni, list, TSI_CONTINUE_LINKING);
    		 //tree  stmt_expr = STATEMENT_LIST_STMT_EXPR (new_tree);
    	     append_to_statement_list_force (tryFinally, &new_tree);
    	     printf("vvv ssss 00000\n");

    	     aet_print_tree_skip_debug(new_tree);

             //tsi_link_after (&ni, tryFinally, TSI_CONTINUE_LINKING);
       	     tree list = alloc_stmt_list ();
      	 	 TREE_OPERAND (tryFinally, 0) = list;
      	 	 //STATEMENT_LIST_STMT_EXPR (list) = stmt_expr;
      	     ni = tsi_start (list);

          printf("在这里加入表达式try_finaly_expr %d\n",count);
      }

    }
}

