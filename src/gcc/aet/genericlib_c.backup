#define LINE_SIZE 1024


static void freeClass_cb(npointer userData)
{
  printf("GenericLib free free %p\n",userData);
}

static void genericLibInit(GenericLib *self)
{
	 self->libPathArray=n_ptr_array_new_with_free_func(n_free);
	 self->fileNameArray=n_ptr_array_new_with_free_func(n_free);
     self->hashTable = n_hash_table_new_full (n_str_hash, n_str_equal,n_free, freeClass_cb);
}

/**
 * 加了object path
 */
static char *getSaveFile(char *name)
{
	char  *path=makefile_parm_get_full_file(makefile_parm_get(),name);
	return path;
}

/**
 * src字符串格式:
 * 0000000000004038 D _test_AObject_global_generic_name
 */
static nboolean existsVarName(char *src,char *varName)
{
	NString *var=n_string_new(src);
	int index=n_string_indexof(var,varName);
    n_string_free(var,TRUE);
    return index>0;
}

/**
 * 是否存在变量
 * varName
 * -W是关键可以取到很长的变量名
 */
static char *readVar(char *fileName,char *varName)
{
	char cmd[512];
	sprintf(cmd,"readelf -s -W %s | grep %s",fileName,varName);
    FILE *fd = popen(cmd, "r");
    //printf("findVar is 00 :%s %p\n",cmd,fd);
    char tempBuff[LINE_SIZE];
    char *result=NULL;
	if(fd){
		while(TRUE){
		  char *ret=fgets(tempBuff, sizeof(tempBuff), fd); //将刚刚FILE* stream的数据流读取到buf中
		  if(ret==NULL){
			 //pclose(fd);
			 break;
		  }
		  if(ret!=NULL && existsVarName(ret,varName)){
			  printf("找到了变量 is 11 :%s\n",ret);
			  result=n_strdup(ret);
			  break;
		  }
		}
		fclose(fd);
	}
	return result;
}

/**
 * 获取变量在data段的虚拟地址
 * src格式如下
 * 10: 0000000000004038     8 OBJECT  GLOBAL DEFAULT   22 _test_AObject_global_generic_name_abcd_1234_672$2_suiwtiwuer_ABdxxyyyyy
 */
static nint64 getVirtAddInDataSegment(char *src,int *size)
{
	if(src==NULL)
		return -1;
	NString *content=n_string_new(src);
	int index=n_string_indexof(content,":");
	if(index<0){
		n_string_free(content,TRUE);
		return -1;
	}
	printf("getVirtAddInDataSegment 00 is:%s\n",src);
	NString *sub=n_string_substring(content,index+1);
	n_string_trim(sub);
    nchar**	items=n_strsplit(sub->str," ",-1);
	n_string_free(content,TRUE);
	n_string_free(sub,TRUE);
    int len=n_strv_length(items);
    if(len==0)
    	return -1;
    int i;
    for(i=1;i<len;i++){
    	printf("findVarNameAndVirtAdd is:%d %s\n",i,items[i]);
    	if(strlen(items[i])>0){
    		*size=atoi(items[i]);
        	printf("findVarNameAndVirtAdd ----- is:%d %s %d\n",i,items[i],*size);
    		break;
    	}
    }
	printf("findVarNameAndVirtAdd vir----- is:%s size:%d\n",items[0],*size);
    nint64	add=n_ascii_strtoll(items[0],NULL,16);
    return add;
}

/**
 *   [22] .data             PROGBITS         0000000000004028  00003028
 */
static nboolean findDataSegment(char *src,char *match)
{
	if(src==NULL)
		return FALSE;
	NString *var=n_string_new(src);
	int index=n_string_indexof(var,match);
	n_string_free(var,TRUE);
	return index>0;
}

/**
 * 读取数据段的地址
 */
static char *readDataSegmentVirtAdd(char *fileName,char *match){
	//char *cmd="readelf -S /home/sns/workspace/testblock/bin/libapptest.so | grep -P \"(bss|data)\"";
	char cmd[512];
	sprintf(cmd,"readelf -S -W %s | grep -P \"(bss|data)\"",fileName);
    FILE *fd = popen(cmd, "r");
    printf("readDataSegmentVirtAdd is 00 :%s %p\n",cmd,fd);
    char tempBuff[LINE_SIZE];
    char *result=NULL;
	if(fd){
		while(TRUE){
		  char *ret=fgets(tempBuff, sizeof(tempBuff), fd); //将刚刚FILE* stream的数据流读取到buf中
		  printf("ret is :%s\n",ret);
		  if(ret==NULL){
			 break;
		  }
		  if(ret!=NULL && findDataSegment(ret,match)){
			  printf("readDataSegmentVirtAdd 找到了变量 is 11 :%s\n",ret);
			  result=n_strdup(ret);
			  break;
		  }
		}
		fclose(fd);
	}
	return result;
}

/**
 * 取.data段的地址
 * [22] .data             PROGBITS        0000000000004028 003028 000020 00  WA  0   0  8
 *
 */
static nint64 getDataSegmentVirtAdd(char *src,nint64 *dataOffset,nint64 *dataSize)
{
	if(src==NULL)
		return -1;
	NString *content=n_string_new(src);
	int index=n_string_indexof(content,"PROGBITS");
	if(index<0){
		n_string_free(content,TRUE);
		return -1;
	}
	printf("getVirtAddInDataSegment 00 is:%s\n",src);
	NString *sub=n_string_substring(content,index+strlen("PROGBITS"));
	n_string_trim(sub);
    nchar**	items=n_strsplit(sub->str," ",-1);
	n_string_free(content,TRUE);
	n_string_free(sub,TRUE);
    int len=n_strv_length(items);
    if(len==0)
    	return -1;
    int i;
    for(i=0;i<len;i++)
    	printf("getVirtAddInDataSegment is:%d %s\n",i,items[i]);
    nint64	add=n_ascii_strtoll(items[0],NULL,16);
    nint64	v1=n_ascii_strtoll(items[1],NULL,16);
    nint64	v2=n_ascii_strtoll(items[2],NULL,16);
    *dataOffset=v1;
    *dataSize=v2;
    return add;
}

static void appendData(char *src,char *buffer,int *offset)
{
    nchar**	items=n_strsplit(src," ",-1);
    int len=n_strv_length(items);
    int i;
    int a=0;
    int count=*offset;
    for(i=1;i<len;i++){
    	if(strlen(items[i])>0 && (items[i])[0]=='|')
    		break;
    	if(strlen(items[i])>0){
    	  sscanf(items[i], "%x", &a);
    	  buffer[count++]=a;
    	  //printf("oppend data is :count:%d %s %d\n",count,items[i],a);
    	}
    }
    *offset=count;
    n_strfreev(items);
}

static char *readContent(char *fileName,nint64 offset,int size,int *dataSize){
	//char *cmd="hexdump ./test -C -s 0x550 -n 28";
	char cmd[512];
	sprintf(cmd,"hexdump %s -C -s %#x -n %d",fileName,offset,size);
    FILE *fd = popen(cmd, "r");
    printf("readContent is 00 :%s %p\n",cmd,fd);
    char tempBuff[LINE_SIZE];
    char content[size+1];
    int dataLen=0;
	if(fd){
		while(TRUE){
		  char *ret=fgets(tempBuff, sizeof(tempBuff), fd); //将刚刚FILE* stream的数据流读取到buf中
		  //printf("readContent ret is :%s\n",ret);
		  if(ret==NULL){
			 break;
		  }
		  if(ret!=NULL){
			  //printf("readContent bbbb 找到了变量 is 11 :%s\n",ret);
			  appendData(ret,content,&dataLen);
		  }
		}
		fclose(fd);
	}
	if(dataLen==0)
	  return NULL;
	char *data=n_malloc(dataLen);
	memcpy(data,content,dataLen);
	*dataSize=dataLen;
	return data;
}

/**
 * content是从readelf -s -W 获取的字符串，格式如下:
 * 10: 0000000000004038     8 OBJECT  GLOBAL DEFAULT   22 _test_AObject_global_generic_name_abcd_1234_672$2_suiwtiwuer_ABdxxyyyyy
 */
static char *getValue(GenericLib *self,char *fileName,char *globalVarName,char *content)
{
	int varSize=0;
	nint64 varVirtAdd=getVirtAddInDataSegment(content,&varSize);
	if(varVirtAdd<0){
		n_error("从字符串取不出虚拟地址！%s %s",content,fileName);
	}
    printf("varVirtAdd------varVirtAdd:%#x varSize:%#x %d\n",varVirtAdd,varSize,varSize);
	char *dataSegmentStr=readDataSegmentVirtAdd(fileName,".data");
	nint64 dataOffset=0;
	nint64 dataSize=0;
	nint64 dataSegmentVirtAdd=getDataSegmentVirtAdd(dataSegmentStr,&dataOffset,&dataSize);
	if(dataSegmentVirtAdd<0){
		n_error("从字符串取不出虚拟地址！%s %s",dataSegmentStr,fileName);
	}
    printf("dataSegmentVirtAdd------virtAdd:%#x offset::%#x size:%#x\n",dataSegmentVirtAdd,dataOffset,dataSize);

//	nint64   segment_data_virt_addr_begin = dataSegmentVirtAdd;
//	nint64   segment_data_virt_addr_end = dataSegmentVirtAdd+dataSize;
//
//
//	nint64 segment_data_offset = dataOffset;
//	printf("segment_data_offset %lli %#x %lli\n",dataOffset,dataOffset,(varVirtAdd - segment_data_virt_addr_begin));
//	nint64 var_offset=segment_data_offset + (varVirtAdd - segment_data_virt_addr_begin);
//    printf("var_offset------var_offset:%#x varVirtAdd::%#x segment_data_virt_addr_begin:%#x\n",var_offset,varVirtAdd,segment_data_virt_addr_begin);
//
//	readContent(fileName,var_offset,varSize);

	nint64 varAdd=varVirtAdd - dataSegmentVirtAdd+dataOffset;//变量名本身的地址
    printf("varAdd------varAdd:%#x\n",varAdd);
    int dataLen=0;
	char *valueVirtAddStr=readContent(fileName,varAdd,16,&dataLen);//变量名指向的初始值地址 00 20 00 00 00 00 00 00
	if(dataLen==0){
		n_error("从字符串取不出虚拟地址！%s %s",dataSegmentStr,fileName);
	}

	nint64 valueVirtAdd=0;
	memcpy(&valueVirtAdd,valueVirtAddStr,sizeof(nuint64));
    printf("valueVirtAdd------valueVirtAdd:%#x\n",valueVirtAdd);
    n_free(valueVirtAddStr);

	char *rodataSegmentStr=readDataSegmentVirtAdd(fileName,".rodata");
	nint64 rodataOffset=0;
	nint64 rodataSize=0;
	nint64 rodataSegmentVirtAdd=getDataSegmentVirtAdd(rodataSegmentStr,&rodataOffset,&rodataSize);
	if(rodataSegmentVirtAdd<0){
		n_error("从字符串取不出虚拟地址！%s %s",dataSegmentStr,fileName);
	}
    printf("rodataSegmentVirtAdd------virtAdd:%#x offset::%#x size:%#x\n",rodataSegmentVirtAdd,rodataOffset,rodataSize);
    nint64 valueAdd=valueVirtAdd - rodataSegmentVirtAdd+rodataOffset;
    printf("valueVirtAdd 2222------valueVirtAdd:%#x\n",valueAdd);

    dataLen=0;
	char *valueStr=readContent(fileName,valueAdd,rodataSize,&dataLen);//变量名指向的初始值地址 00 20 00 00 00 00 00 00
	if(dataLen==0){
		n_error("从字符串取不出虚拟地址！%s %s",dataSegmentStr,fileName);
	}
    char *str=n_strdup(valueStr);
    printf("str is ---- %s\n",valueStr);
	n_free(dataSegmentStr);
	return NULL;
}

static char *findVar(GenericLib *self,char *fileName,char *globalVarName)
{
	char *result=readVar(fileName,globalVarName);
	return result;
}

static void addLibPath(NPtrArray *array,char *newPath)
{
	int i;
	nboolean find=FALSE;
	for(i=0;i<array->len;i++){
		char *item=n_ptr_array_index(array,i);
		if(strcmp(item,newPath)==0){
			find=TRUE;
			break;
		}
	}
	if(!find){
		n_ptr_array_add(array,n_strdup(newPath));
	}
}

static char *getStr(char *src,char *match)
{
	  NString *ss=n_string_new(src);
	  int of=n_string_indexof(ss,match);
	  char *result=NULL;
	  if(of>=0){
		   of=n_string_indexof(ss,"=");
		   if(of>0){
			   NString *r=n_string_substring(ss,of+1);
			   n_string_trim(r);
			   result=n_strdup(r->str);
			   n_string_free(r,TRUE);
		   }
	  }
	  n_string_free(ss,TRUE);
	  return result;
}



static void find(GenericLib *self,NList *list,char *varName,NPtrArray *array)
{
	int len=n_list_length(list);
	int i;
	for(i=0;i<len;i++){
		NFile *file=n_list_nth_data(list,i);
		char *fp=n_file_get_absolute_path(file);
		NString *f=n_string_new(fp);
		if(n_string_ends_with(f,".so")){
            char *result= findVar(self,fp,varName);
            if(result!=NULL){
            	n_ptr_array_add(array,n_strdup(fp));
                printf("file is:%s %s\n",result,fp);
            }
		}
		n_string_free(f,TRUE);
	}
}


/**
 * 如果库中有全局变量的前缀与GLOBAL_GENERIC_NAME_PREFIX相同，就保留该文件
 */
static void filter(GenericLib *self,NPtrArray *libPathArray)
{
	NPtrArray *fileArray=self->libPathArray;
	int i;
	int len=libPathArray->len;
	for(i=0;i<len;i++){
		char *path=n_ptr_array_index(libPathArray,i);
		NFile *file=n_file_new(path);
		NList *list=n_file_list_files_to_list(file);
		find(self,list,GLOBAL_GENERIC_NAME_PREFIX,fileArray);
		n_list_free(list);
		list=NULL;
	}
}

/**
 * 分三种情况
 * 1. -L
 * 2. -l
 * 3. --rpath-link
 */
static void readLibPath(GenericLib *self)
{
	char *fileName=getSaveFile(SAVE_LIB_PARM_FILE);//"aet_collect2_argv.txt";
	FILE *fp=fopen(fileName,"r");
	char **items=NULL;
	if(fp){
		char buffer[1024*10];
		int re = fread(buffer, sizeof(char), 10*1024, fp);
		if(re>0){
		   buffer[re]='\0';
		   items=n_strsplit(buffer,"\n",-1);
		}
		fclose(fp);
	}
	if(items==NULL)
		return ;
	NPtrArray *pathArray=n_ptr_array_new_with_free_func(n_free);
	int len=n_strv_length(items);
	int i;
	for(i=0;i<len;i++){
	  char *str=items[i];
	  if(strlen(str)>2 && str[0]=='-' && str[1]=='L'){
		  char *str1=str+2;
		 // printf("value ---- is:%d %s\n",i,str1);
		  addLibPath(pathArray,str1);
	  }else if(strstr(str,"--rpath-link") || strstr(str,"--rpath")){
		  char *str1=getStr(str,"--rpath-link");
		  if(str1==NULL)
			  str1=getStr(str,"--rpath");
		  if(str1!=NULL){
			  //printf("value ---222- is:%d %s\n",i,str1);

			  addLibPath(pathArray,str1);
              n_free(str1);
		  }
	  }else if(strlen(str)>2 && str[0]=='-' && str[1]=='l'){
		  char *str1=str+2;
		  addLibPath(self->fileNameArray,str1);
	  }
	}
	filter(self,pathArray);
	n_ptr_array_unref(pathArray);
}

/**
 * _A_glb_GEN_name_test_AObject=2_0
 * 2指块数
 * 0指test_AObject类中未定的象“”new$ Abc<E>“这样的对象个数
 */
static char * getGlobalValue(GenericLib *self,char *varName,char **fileName)
{
		int i;
		int len=self->libPathArray->len;
		for(i=0;i<len;i++){
			char *path=n_ptr_array_index(self->libPathArray,i);
			printf("getGlobalValue path is :%s\n",path);
            char *result= findVar(self,path,varName);
            if(result!=NULL){
           	   char *value=getValue(self,path,varName,result);
           	   n_free(result);
           	   *fileName=n_strdup(path);
           	   return value;
            }
		}
		return NULL;
}

typedef struct _BlockData
{
	char *name;
	char *codes;
}BlockData;

typedef struct _UndefineObjectData
{
	char *name;
	char *codes;
}UndefineObjectData;

typedef struct _GenericFuncCallData
{
	char *name;
	char *codes;
}GenericFuncCallData;

typedef struct _DefineObjectData
{
	char *name;
	char *codes;
}DefineObjectData;

typedef struct _GenericData
{
	int blocks;
	int undefineObjectCount;
	int defineObjectCount;
	NPtrArray *blocksArray;
	UndefineObjectData *undefineObj;
	DefineObjectData *defineObj;
	GenericFuncCallData *funcCall;
	char *fileClassLocated;//类所在文件
}GenericData;


static GenericData *createGenericData(GenericLib *self,char *sysName)
{
	char globalVarName[256];
	generic_util_create_global_generic_var_name(sysName,globalVarName);
	char *fileName=NULL;
	char *globalValue=getGlobalValue(self,globalVarName,&fileName);
	GenericData *data=n_slice_new0(GenericData);
	if(globalValue==NULL){
		data->blocks=0;
		data->undefineObjectCount=0;
		data->defineObjectCount=0;
		n_hash_table_insert (self->hashTable, n_strdup(sysName),data);
		if(fileName!=NULL)
		  n_free(fileName);
		return data;
	}

	//2_0_1 块数和未定泛型和确定泛型的new$ Abc<E>数
   char **items=n_strsplit(globalValue,"_",-1);
   int blocks=atoi(items[0]);
   int undefineObj=atoi(items[1]);
   int defineObj=atoi(items[2]);
   data->blocks=blocks;
   data->undefineObjectCount=undefineObj;
   data->defineObjectCount=defineObj;
   n_strfreev(items);
   n_free(globalValue);
   if(blocks>0)
	   data->blocksArray=n_ptr_array_new();
   int i;
   for(i=0;i<data->blocks;i++){
	   char *varName=generic_util_create_global_var_for_block_func_name(sysName,i+1);
	   char *result=findVar(generic_lib_get(),fileName,varName);
	   if(result==NULL){
		   n_error("出错在.so文件，找不到变量。%s %s",fileName,varName);
	   }
	   char *value=getValue(self,fileName,varName,result);
	   if(value==NULL){
		   n_error("出错在.so文件，找不到泛型块代码。%s %s",fileName,varName);
	   }
	   BlockData *bd=n_slice_new(BlockData);
	   bd->name=n_strdup(varName);
	   bd->codes=n_strdup(value);
	   n_free(varName);
	   n_free(result);
	   n_free(value);
	   n_ptr_array_add(data->blocksArray,bd);
   }
   if(data->undefineObjectCount>0){
	   data->undefineObj=(UndefineObjectData *)n_slice_new(UndefineObjectData);
	   char *varName=generic_util_create_undefine_new_object_var_name(sysName);
	   char *result=findVar(generic_lib_get(),fileName,varName);
	   if(result==NULL){
		   n_error("出错在.so文件，找不到变量。%s %s",fileName,varName);
	   }
	   char *value=getValue(self,fileName,varName,result);
	   if(value==NULL){
		  n_error("出错在.so文件，找不到泛型块代码。%s %s",fileName,varName);
	   }
	   data->undefineObj->name=n_strdup(varName);
	   data->undefineObj->codes=n_strdup(value);
	   n_free(varName);
	   n_free(result);
	   n_free(value);
   }

   if(data->defineObjectCount>0){
	   data->defineObj=(DefineObjectData *)n_slice_new(DefineObjectData);
	   char *varName=generic_util_create_define_new_object_var_name(sysName);
	   char *result=findVar(generic_lib_get(),fileName,varName);
	   if(result==NULL){
		   n_error("出错在.so文件，找不到变量。%s %s",fileName,varName);
	   }
	   char *value=getValue(self,fileName,varName,result);
	   if(value==NULL){
		  n_error("出错在.so文件，找不到泛型块代码。%s %s",fileName,varName);
	   }
	   data->defineObj->name=n_strdup(varName);
	   data->defineObj->codes=n_strdup(value);
	   n_free(varName);
	   n_free(result);
	   n_free(value);
   }

   char *varName=generic_util_create_func_generic_call_var_name(sysName);
   char *result=findVar(generic_lib_get(),fileName,varName);
   if(result!=NULL){
	  char *value=getValue(self,fileName,varName,result);
	  if(value==NULL){
		 n_error("出错在.so文件，找不到泛型块代码。%s %s",fileName,varName);
	  }
	  data->funcCall=(GenericFuncCallData *)n_slice_new(GenericFuncCallData);
	  data->funcCall->name=n_strdup(varName);
	  data->funcCall->codes=n_strdup(value);
	  n_free(value);
	  n_free(result);
   }
   n_free(varName);

   //找类所在的文件名
   char *key=generic_util_create_class_key_in_file(sysName);
   char *belongFile=findVar(generic_lib_get(),fileName,key);
   if(belongFile!=NULL){
	  char *value=getValue(self,fileName,varName,result);
	  if(value==NULL){
		 n_error("出错在.so文件，找不到类所在的文件名。%s %s %s",fileName,key);
	  }
	  data->fileClassLocated=n_strdup(value);
	  n_free(belongFile);
   }
   n_free(key);
   n_hash_table_insert (self->hashTable, n_strdup(sysName),data);
   n_free(fileName);
   return data;

}


/**
 * 返回代表泛型类的4种类型的数据
 */
static GenericData *getGenericData(GenericLib *self,char *sysName)
{
	GenericData *genData=(GenericData *)n_hash_table_lookup(self->hashTable,sysName);
	if(genData==NULL){
		genData=createGenericData(self,sysName);
	}
	return genData;
}

