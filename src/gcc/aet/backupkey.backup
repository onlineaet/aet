/*保存开发过程中一些重要的方法，这些方法由于各种原因，在当前版本不再需要，但有参考价值。*/

/**
 *  创建如下语句
 *  ((Abc *)self->_generic_blocks_1234)->func_1(self,a1);
 *  如果是在泛型函数中的块加参数FuncGenParmInfo tempFgpi1234
*/
tree generic_info_build_call(GenericInfo *self,tree lhs,char *fname,vec<tree, va_gc> *exprlist,nboolean isFuncGen)
{
	//()self->AET_GENERIC_BLOCK_STRUCT_VAR_NAME
	location_t loc=input_location;
	//(Abc *)
	tree objtype=build_pointer_type(TREE_TYPE(self->genStructDecl));
	//self->_generic_blocks_1234
	tree selfid=lookup_name(aet_utils_create_ident("self"));
	tree selfref=build_indirect_ref (loc,selfid,RO_ARROW);
	tree component1=aet_utils_create_ident(AET_GENERIC_BLOCK_STRUCT_VAR_NAME);
	tree rhs = build_component_ref (loc,selfref,component1, loc);//
    //完成了((Abc *)self->_generic_blocks_1234)
    rhs= build1 (NOP_EXPR, objtype, rhs);
    //完成((Abc *)self->_generic_blocks_1234)->func_1
	tree field=getField(self,fname);
	tree fieldName=DECL_NAME(field);
	tree datum=build_indirect_ref (loc,rhs,RO_ARROW);
	tree component2 = build_component_ref (loc,datum,fieldName, loc);
	if(isFuncGen){
		tree id=aet_utils_create_ident(AET_FUNC_GENERIC_PARM_NAME);
		tree funcGenParmInfo=lookup_name(id);
		vec_safe_insert (exprlist, 0, funcGenParmInfo);
	}
	vec_safe_insert (exprlist, 0, selfid);
	tree rtn=void_type_node;
	if(aet_utils_valid_tree(lhs))
		rtn=TREE_TYPE(lhs);
    tree result = build_call_vec (rtn,component2, exprlist);
    return result;
}

/**
 * 创建 typedef void (*func)(int abc);
 */
static void createTypeDecl(GenericInfo *self,int index,tree lhs,vec<tree, va_gc> *exprlist)
{

    char *fname=generic_util_create_block_func_type_decl_name(self->className->sysName,index);
	tree param_type_list = NULL;
	tree selfclass=lookup_name(aet_utils_create_ident("self"));
	tree selftype=build_pointer_type(TREE_TYPE(selfclass));
    param_type_list = tree_cons (NULL_TREE, selftype, param_type_list);
    //加入第二个参数FuncGenParmInfo
	tree funcGenParmInfoType=createQueryParmType();
	param_type_list = tree_cons (NULL_TREE, funcGenParmInfoType, param_type_list);

	if(exprlist==NULL || exprlist->length()==0){
		;
	}else{
	  int ix;
	  tree arg;
	  for (ix = 0; exprlist->iterate (ix, &arg); ++ix){
		printf("replaceField 11 有参数 %d\n",ix);
		tree gen=c_aet_get_generics(arg);
		aet_print_tree(gen);
		printf("replaceField 22 有参数 %d\n",ix);
		aet_print_tree(arg);
		tree param_type=TREE_TYPE(arg);
	    param_type_list = tree_cons (NULL_TREE, param_type, param_type_list);
	  }
	}
	param_type_list = tree_cons (NULL_TREE, void_type_node, param_type_list);
	  /* The 3 lists have been created in reverse order.  */
	param_type_list = nreverse (param_type_list);
	  /* Build the function type.  */
	tree rtntype=void_type_node;
	if(aet_utils_valid_tree(lhs)){
		rtntype=TREE_TYPE(lhs);
	}
	tree fntype = build_function_type (rtntype, param_type_list);
	tree pointer=build_pointer_type(fntype);
	tree pointer2=pointer;//build_pointer_type(pointer);
    tree typeNameId=aet_utils_create_ident(fname);
	tree decl = build_decl (input_location, TYPE_DECL, typeNameId, pointer2);
    //TYPE_NAME(pointer2)=decl;
    DECL_ARTIFICIAL (decl) = 1;
    DECL_CONTEXT(decl)=NULL_TREE;
    DECL_EXTERNAL(decl)=0;
    TREE_STATIC(decl)=0;
    TREE_PUBLIC(decl)=0;
    set_underlying_type (decl);
    record_locally_defined_typedef (decl);
	c_c_decl_bind_file_scope(decl);//放在file_scope，c_c_decl_bind_file_scope是增加的,原本没有
	finish_decl (decl, input_location, NULL_TREE,NULL_TREE, NULL_TREE);

    printf("createTypeDecl xx----\n");
    aet_print_tree(decl);
}


/**
 * 把结构体
 * test_Abc_gen_struct内的函数声明替换了( sprintf(name,"%s_gen_struct",className->sysName);)
 * 名字不变，参数用exprlist改变，返回值应该也要改变
 */
static void replaceFieldParams(GenericInfo *self,tree lhs,vec<tree, va_gc> *exprlist,char *fieldName,nboolean isFuncGen)
{
	tree param_type_list = NULL;
	tree selfclass=lookup_name(aet_utils_create_ident("self"));
	tree selftype=build_pointer_type(TREE_TYPE(selfclass));
    param_type_list = tree_cons (NULL_TREE, selftype, param_type_list);
	if(isFuncGen){
	    tree id=aet_utils_create_ident(AET_FUNC_GENERIC_PARM_NAME);
		tree funcGenParmInfo=lookup_name(id);
		tree funcGenParmInfoType=TREE_TYPE(funcGenParmInfo);
	    param_type_list = tree_cons (NULL_TREE, funcGenParmInfoType, param_type_list);
	}
	if(exprlist==NULL || exprlist->length()==0){
		;
	}else{
	  int ix;
	  tree arg;
	  for (ix = 0; exprlist->iterate (ix, &arg); ++ix){
		printf("replaceField 11 有参数 %d\n",ix);
		tree gen=c_aet_get_generics(arg);
		aet_print_tree(gen);
		printf("replaceField 22 有参数 %d\n",ix);
		aet_print_tree(arg);
		tree param_type=TREE_TYPE(arg);
	    param_type_list = tree_cons (NULL_TREE, param_type, param_type_list);
	  }
	}
	param_type_list = tree_cons (NULL_TREE, void_type_node, param_type_list);
	  /* The 3 lists have been created in reverse order.  */
	param_type_list = nreverse (param_type_list);
	  /* Build the function type.  */
	tree rtntype=void_type_node;
	if(aet_utils_valid_tree(lhs)){
		rtntype=TREE_TYPE(lhs);
	}
	tree fntype = build_function_type (rtntype, param_type_list);
	tree field=getField(self,fieldName);
	TREE_TYPE(field)=build_pointer_type(fntype);
}


/**
 * 用程序创建结构体
 */
static void finish_struct (tree decl, tree fields)
{
  tree tail, next;
  tree type=TREE_TYPE(decl);
  printf("finish_struct----\n");
  tree _type=TYPE_MAIN_VARIANT(type);
  for (tail = NULL_TREE; fields; tail = fields, fields = next)
    {
      DECL_CONTEXT (fields) = _type;
      next = DECL_CHAIN (fields);
      DECL_CHAIN (fields) = tail;
    }
  TYPE_FIELDS (_type) = tail;
  layout_type (_type);
  tree x;
  tree t=_type;
  for (x = TYPE_MAIN_VARIANT (t); x; x = TYPE_NEXT_VARIANT (x)){
      TYPE_FIELDS (x) = TYPE_FIELDS (t);
      TYPE_LANG_SPECIFIC (x) = TYPE_LANG_SPECIFIC (t);
      TYPE_TRANSPARENT_AGGR (x) = TYPE_TRANSPARENT_AGGR (t);
      C_TYPE_FIELDS_READONLY (x) = C_TYPE_FIELDS_READONLY (t);
      C_TYPE_FIELDS_VOLATILE (x) = C_TYPE_FIELDS_VOLATILE (t);
      C_TYPE_VARIABLE_SIZE (x) = C_TYPE_VARIABLE_SIZE (t);
      C_TYPE_INCOMPLETE_VARS (x) = NULL_TREE;
   }

 // TYPE_NAME (type) = build_decl (BUILTINS_LOCATION,TYPE_DECL, get_identifier (name), type);
  //TYPE_STUB_DECL (type) = TYPE_NAME (type);
  //layout_decl (decl, 0);
}

/**
 * 在类声明中如果有泛型声明，
 * 在类的最后加一个void *AET_GENERIC_BLOCK_STRUCT_VAR_NAME  "_generic_blocks_1234"
 * _generic_blocks_1234在这里指向一个结构体，名称是:类名 _gen_struct
 * 结构体内全是函数域
 */
static void createStruct(GenericInfo *self)
{
	ClassName *className=self->className;
    char *name=generic_util_create_block_struct_name(self->className->sysName);
    tree  type = make_node (RECORD_TYPE);
    char _name[128];
    sprintf(_name,"_%s",name);
    tree  id=aet_utils_create_ident(_name);
    TYPE_NAME (type) = id;
    tree  idx=aet_utils_create_ident(name);
    tree decl = build_decl (input_location,TYPE_DECL,idx, type);
    DECL_ARTIFICIAL (decl) = 1;
    DECL_CONTEXT(decl)=NULL_TREE;
    DECL_EXTERNAL(decl)=0;
    TREE_STATIC(decl)=0;
    TREE_PUBLIC(decl)=0;
    set_underlying_type (decl);
    record_locally_defined_typedef (decl);
	c_c_decl_bind_file_scope(decl);//放在file_scope，c_c_decl_bind_file_scope是增加的,原本没有
	finish_decl (decl, input_location, NULL_TREE,NULL_TREE, NULL_TREE);
    printf("创建装泛型块函数的结构体 类名:%s 结构体名:%s 最大块数：%d\n",className->sysName,name,MAX_GEN_BLOCKS);
    n_free(name);
    tree contents=NULL_TREE;
    int i;
    for(i=0;i<MAX_GEN_BLOCKS;i++){
		tree ft = build_function_type (void_type_node, NULL_TREE);
		tree ftype=build_pointer_type(ft);
	    char *fname=generic_util_create_block_func_name(self->className->sysName,i+1);
		tree funName=aet_utils_create_ident(fname);
		tree field_decl = build_decl (input_location, FIELD_DECL, funName, ftype);
		finish_decl (field_decl, input_location, NULL_TREE, NULL_TREE, NULL_TREE);
		DECL_CHAIN (field_decl) = contents;
		contents = field_decl;
		n_free(fname);
    }
    finish_struct(decl,contents);
//
//    tree chain;
//	tree record=TREE_TYPE(decl);
//	printf("tttxxxxxeeeeeee----------\n");
//    tree fieldList=TYPE_FIELDS(record);
//    int count=0;
//	for (chain = fieldList; chain; chain = DECL_CHAIN (chain)){
//	    printf("createsturnct----11xxx %d %p\n",count++,chain);
//	    aet_print_tree(chain);
//	}
    self->genStructDecl=decl;
}


/**
 * 创建一个空的FuncGenParmInfo等同于
 * ({FuncGenParmInfo info;info.count=0;info.countOfBlockClass=0;info.info;})
 */
tree generic_util_create_zero_fgpi_parm()
{
    location_t loc=input_location;
	tree type= generic_util_get_fgpi_record_type();
	tree varDecl=build_decl(0, VAR_DECL, NULL_TREE, type);

	DECL_ARTIFICIAL (varDecl)=1;
	TREE_USED (varDecl)=1;
	////////
	//tree bindVarDecl=createParmVar();
    tree bindVarDecl = build_decl (0,VAR_DECL,aet_utils_create_ident("info"), type);
	TREE_USED (bindVarDecl)=1;

	tree stmtList=alloc_stmt_list();
	tree stmt0 = build_stmt (0, DECL_EXPR, void_type_node);
	append_to_statement_list_force (stmt0, &stmtList);
	{
		   tree ident=aet_utils_create_ident("count");
		   tree componentRef = build_component_ref (loc,bindVarDecl,ident, loc);//@104 完成 //生成info.pms
		   unsigned HOST_WIDE_INT value;
		   value=0;
		   tree rvalue=build_int_cst (integer_type_node, value);
		   tree stmt2 = build_modify_expr (loc, componentRef, TREE_TYPE(rvalue),NOP_EXPR,loc,rvalue,TREE_TYPE(rvalue));
		   append_to_statement_list_force (stmt2, &stmtList);
	}

	{
	   tree ident=aet_utils_create_ident("countOfBlockClass");
	   tree componentRef = build_component_ref (loc,bindVarDecl,ident, loc);//@104 完成 //生成info.pms
	   unsigned HOST_WIDE_INT value;
	   value=0;
	   tree rvalue=build_int_cst (integer_type_node, value);
	   tree stmt2 = build_modify_expr (loc, componentRef, TREE_TYPE(rvalue),NOP_EXPR,loc,rvalue,TREE_TYPE(rvalue));
	   append_to_statement_list_force (stmt2, &stmtList);
	}
	tree stmt3 = build_modify_expr (loc, varDecl, void_type_node,NOP_EXPR,0,bindVarDecl,TREE_TYPE(bindVarDecl));
	append_to_statement_list_force (stmt3, &stmtList);

    tree bind = build3 (BIND_EXPR, void_type_node, bindVarDecl, stmtList, NULL_TREE);
    tree target = build4 (TARGET_EXPR, type, varDecl, bind, NULL_TREE, NULL_TREE);
    aet_print_tree(target);
    return target;
}



