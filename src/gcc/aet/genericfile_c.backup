#define GENERIC_FILE_SIZE (512*1024)
#define COLLECT_SPERATOR "BV@hg8#"

static void genericFileInit(GenericFile *self)
{
	   self->secondCompileFile=NULL;
	   self->blockFile=NULL;
}

static void initLockFile(GenericFile *self)
{
	  if(self->blockFile==NULL){
	       char *objectPath=makefile_parm_get_object_root_path(makefile_parm_get());
		   char fileName[255];
		   sprintf(fileName,"%s/%s",objectPath,GENERIC_BLOCK_INTO_FILE_NAME);
		   self->blockFile=link_file_new(fileName);
	  }
}

static char *createFuncCallVarName()
{
	   char *fileName=in_fnames[0];
	   char temp[256];
	   sprintf(temp,"%s_func_call",fileName);
	   return n_strdup(temp);
}

/**
 * 当前文件使用了 new$ Abc<int>();
 * 把当前文件名记录在GENERIC_SECOND_COMPILE_FILE_NAME中，第一次编译 生成目录时，根据GENERIC_SECOND_COMPILE_FILE_NAME
 * 中的内容删除对应的.o文件（删除是在第一次make）
 */
void generic_file_use_generic(GenericFile *self)
{
	  if( self->secondCompileFile==NULL){
	    char *objectPath=makefile_parm_get_object_root_path(makefile_parm_get());
	    char fileName[255];
	    sprintf(fileName,"%s/%s",objectPath,GENERIC_SECOND_COMPILE_FILE_NAME);
	    self->secondCompileFile=link_file_new(fileName);
		  //说明要编译两次，把当前文件从makefile传来的参数也保存在与.o同目录的位置
	    makefile_parm_write_compile_argv(makefile_parm_get());
	  }
	  char *fileName=makefile_parm_get_object_file(makefile_parm_get());
	  int fd=link_file_lock(self->secondCompileFile);
      char buffer[10*1024];
	  int re=link_file_read(self->secondCompileFile,buffer,10*1024);
	  NString *indexStr=n_string_new("");
	  if(re>0){
		  buffer[re]='\0';
		  n_string_append(indexStr,buffer);
		  nchar **items=n_strsplit(buffer,"\n",-1);
		  int length= n_strv_length(items);
		  int i;
		  for(i=0;i<length;i++){
			  char *tx=items[i];
			  if(strcmp(tx,fileName)==0){
				  n_string_free(indexStr,TRUE);
				  link_file_unlock(fd);
				  return;
			  }
		  }
		  n_strfreev(items);
      }
	  char data[255];
	  sprintf(data,"%s\n",fileName);
	  link_file_apppend(self->secondCompileFile,data,strlen(data));
	  n_string_free(indexStr,TRUE);
	  link_file_unlock(fd);
}

/**
 * 第一次编译，如果遇到 new$ Abc<int>()
 * 把当前所在文件保存到GENERIC_SECOND_COMPILE_FILE_NAME
 * 第二次编译，从库或GENERIC_BLOCK_INTO_FILE_NAME中找出泛型代码
 * 通过 makefile传到编译器的参数second_compile_yes或second_compile_no
 */
nboolean   generic_file_is_second_compile(GenericFile *self)
{
   return makefile_parm_is_second_compile(makefile_parm_get());
}

////////////////////////////////////////////新的方法----------------------------------

static nboolean exitsContent(char *sysName,char *item)
{
	  if(sysName==NULL){
		  char *fileName=in_fnames[0];
		  NString *cp=n_string_new(item);
		  if(n_string_starts_with(cp,fileName)){
			  return TRUE;
		  }
		  return FALSE;
	  }
	  char globalVar[255];
	  generic_util_create_global_generic_var_name(sysName,globalVar);
	  NString *cp=n_string_new(item);
	  if(n_string_starts_with(cp,globalVar)){ //_test_AObject_global_generic_name
		  n_string_free(cp,TRUE);
		  return TRUE;
	  }
	  int i;
	  for(i=0;i<100;i++){
		 char *fname=generic_util_create_block_func_name(sysName,i+1);
		 if(n_string_starts_with(cp,fname)){
		 	   n_string_free(cp,TRUE);
		 	   n_free(fname);
		 	   return TRUE;
		 }
 	     n_free(fname);
	  }
	  char *varName=generic_util_create_undefine_new_object_var_name(sysName);
	  if(n_string_starts_with(cp,varName)){ //varName=com_ai_MatrixOps_create_undefine_var
		  n_string_free(cp,TRUE);
	 	  n_free(varName);
		  return TRUE;
	  }
 	  n_free(varName);

	  char *defineVarName=generic_util_create_define_new_object_var_name(sysName);
	  if(n_string_starts_with(cp,defineVarName)){ //varName=com_ai_MatrixOps_create_define_var
		  n_string_free(cp,TRUE);
	 	  n_free(defineVarName);
		  return TRUE;
	  }
 	  n_free(defineVarName);

	  char *callFuncVarName=generic_util_create_func_generic_call_var_name(sysName);
	  if(n_string_starts_with(cp,callFuncVarName)){ //_test_AObject_func_generic_call_1
		  n_string_free(cp,TRUE);
	 	  n_free(callFuncVarName);
		  return TRUE;
	  }
 	  n_free(callFuncVarName);

	  char *classFileKey=generic_util_create_class_key_in_file(sysName);
	  if(n_string_starts_with(cp,classFileKey)){ //varName=com_ai_MatrixOps_create_define_var
			  n_string_free(cp,TRUE);
		 	  n_free(classFileKey);
			  return TRUE;
	  }
	  n_free(classFileKey);
	  n_string_free(cp,TRUE);
	  return FALSE;
}

static nboolean exitsNewObject(char *item)
{
	  char *fileName=in_fnames[0];
	  NString *cp=n_string_new(item);
	  if(n_string_starts_with(cp,fileName)){ //_test_AObject_global_generic_name
		  n_string_free(cp,TRUE);
		  return TRUE;
	  }
	  n_string_free(cp,TRUE);
	  return FALSE;
}

static nboolean exitsFuncGenericCall(char *item)
{
	  char *varName=createFuncCallVarName();
	  NString *cp=n_string_new(item);
	  if(n_string_starts_with(cp,varName)){ //_test_AObject_global_generic_name
		  n_string_free(cp,TRUE);
		  n_free(varName);
		  return TRUE;
	  }
	  n_free(varName);
	  n_string_free(cp,TRUE);
	  return FALSE;
}



/**
 * remove==0 移走类中的undefine new$对象 类中的块 类中的泛型函数调用
 * remove==1 移走new$ 对象
 * remove==2 移走类外的泛型函数调用
 */
static void writeData(GenericFile *self,char *sysName,char *newContent,int remove)
{
	  char buffer[GENERIC_FILE_SIZE];
	  int re=link_file_read(self->blockFile,buffer,GENERIC_FILE_SIZE);
	  NString *indexStr=n_string_new("");
	  if(re>0){
		  buffer[re]='\0';
		  nchar **items=n_strsplit(buffer,COLLECT_SPERATOR,-1);
		  int length= n_strv_length(items);
		 // printf("updateIndex --- %d re:%d %s\n",length,re,buffer);
		 // printf("updateIndex ---over\n");
		  int i;
		  for(i=0;i<length;i++){
			  char *tx=items[i];
			 if(strcmp(tx,COLLECT_SPERATOR)==0 || strstr(tx,"(null)") || strcmp(tx," ")==0 || strlen(tx)==0){
				 //printf("save is containsxxxx %d %s\n",i,tx);
				 ;
			 }else{
				if(remove==0){
					if(exitsContent(sysName,tx)){
					   //printf("save is contains %d %s\n",i,tx);
					   ;
					}else{
					  n_string_append(indexStr,tx);
					  n_string_append(indexStr,COLLECT_SPERATOR);
					}
				}else if(remove==1){
					if(exitsNewObject(tx)){
					   //printf("有newobject内容 %d %s %s\n",i,tx,newContent);
					   ;
					}else{
					  n_string_append(indexStr,tx);
					  n_string_append(indexStr,COLLECT_SPERATOR);
					}
				}else{
					if(exitsFuncGenericCall(tx)){
					   //printf("有泛型函数调用内容 %d %s\n",i,tx);
					   ;
					}else{
					  n_string_append(indexStr,tx);
					  n_string_append(indexStr,COLLECT_SPERATOR);
					}
				}
			 }

		  }
		  n_strfreev(items);
	  }
//	  fclose(fp);
//	  fp = fopen(saveFileName, "w");
//	  if(!fp){
//		 if(errno==17){
//		   fp = fopen(saveFileName, "r+x");
//		 }
//		 if(!fp){
//		   n_error("打不开文件----:%s error:%d %s\n",saveFileName,errno,xstrerror(errno));
//		   return;
//		 }
//	  }
	  if(newContent!=NULL){
	    n_string_append_printf(indexStr,"%s",newContent);
	  }
	  //printf("generic_file_save -eeee-fileName:%s %s %s\n",saveFileName,indexStr->str,newContent);
	 // re=fwrite(indexStr->str,1,indexStr->len,fp);
	 // fclose(fp);
	  re=link_file_write(self->blockFile,indexStr->str,indexStr->len);

	  n_string_free(indexStr,TRUE);
}

static void saveData(GenericFile *self,char *sysName,char *newContent,int remove)
{
     int fd=link_file_lock(self->blockFile);
     writeData(self,sysName,newContent,remove);
     link_file_unlock(fd);
}

/**
 * 保存:1.块数与未定泛型的new对象。2.类实现中的块（块只能在类实现在）。3.类中未确定泛型的的new$ object。4.类中确定泛型的new$ object,5. 类中的泛型函数调用
 * 保存块所属的函数以及所属函数是否是泛型函数，如:_Z7AObject7AObjectEPN7AObjectE$WWtx$0$WWtx$
 * 在类impl完成后调用
 */
void generic_file_save(GenericFile *self,ClassName *className)
{
	    initLockFile(self);
	   nboolean second=  generic_file_is_second_compile(self);
	   if(second){
		 n_warning("第二次编译不需要再保存 %s 文件:%s\n",className->sysName,in_fnames[0]);
	     return;
	   }
	   int blockCount=block_mgr_get_block_count(block_mgr_get(),className);
	   int undefineObject=block_mgr_get_undefine_newobj_count(block_mgr_get(),className);
	   int defineObject=block_mgr_get_define_newobj_count(block_mgr_get(),className);

	   char varName[256];
	   generic_util_create_global_generic_var_name(className->sysName,varName);
	   char content[256];
	   sprintf(content,"%d_%d_%d",blockCount,undefineObject,defineObject);
	   //_test_AObject_global_generic_name=0_0_0
	   NString *source=n_string_new("");
	   n_string_append_printf(source,"%s=%s",varName,content);
	   n_string_append(source,COLLECT_SPERATOR);
//	   _test_AObject__inner_generic_func_1_create_block_var=_Z7AObject7AObjectEPN7AObjectE$WWtx$0$WWtx$ void _test_AObject__inner_generic_func_1(test_AObject *self,int txyz)
//	    {
//	    printf ( "abcd--eee--" ) ;
//
//	    }
	   int i;
	   for(i=0;i<blockCount;i++){
		   char   **var=block_mgr_get_block_source(block_mgr_get(),className,i);
		   //var[0]=_test_AObject__inner_generic_func_1_create_block_var
		   n_string_append_printf(source,"%s=%s",var[0],var[1]);
		   n_string_append(source,COLLECT_SPERATOR);
		   n_strfreev(var);
	   }
	   //test_Abc_create_undefine_var ="test_Abc$WWtx$test_AObject$WWtx$E0$WWtx$"
	   char **undefineObjectSource=block_mgr_get_undefine_newobj_source_codes(block_mgr_get(),className);
	   if(undefineObjectSource!=NULL){
		   n_string_append_printf(source,"%s=%s",undefineObjectSource[0],undefineObjectSource[1]);
		   n_string_append(source,COLLECT_SPERATOR);
		   n_strfreev(undefineObjectSource);
	   }

	   //test_Abc_create_define_var ="test_Abc$WWtx$test_AObject$WWtx$E0$WWtx$"
	   char **defineObjectSource=block_mgr_get_define_newobj_source_codes(block_mgr_get(),className);
	   if(defineObjectSource!=NULL){
		   n_string_append_printf(source,"%s=%s",defineObjectSource[0],defineObjectSource[1]);
		   n_string_append(source,COLLECT_SPERATOR);
		   n_strfreev(defineObjectSource);
	   }
       //保存类中的泛型函数调用
	   char  **funcCall=block_mgr_get_func_generic_call_in_class(block_mgr_get(),className);
	   if(funcCall!=NULL){
		   n_string_append_printf(source,"%s=%s",funcCall[0],funcCall[1]);
		   n_string_append(source,COLLECT_SPERATOR);
		   n_strfreev(funcCall);
	   }

	   //保存类属于那个文件
	  {
	    char *key=generic_util_create_class_key_in_file(className->sysName);
	    char *fileName=in_fnames[0];
	    n_string_append_printf(source,"%s=%s",key,fileName);
	    n_string_append(source,COLLECT_SPERATOR);
	    n_free(key);
	  }
	   saveData(self,className->sysName,source->str,0);
 	   n_string_free(source,TRUE);
}

/**
 * 保存当前文件中new$泛型确定的对象
 * /home/sns/workspace/ai/src/test/ai.c=unknown$WWtx$test_IMatrix$WWtx$int0$WWtx$
 * unknown$WWtx$test_LU$WWtx$int0$WWtx$
 * 在.c编译完后调用
 */
void generic_file_save_define_new$(GenericFile *self,char *content)
{
        initLockFile(self);
	   char *fileName=in_fnames[0];
	   //printf("generic_file_save_define_new$---xx %s %s\n",fileName,content);
	   if(content!=NULL){
	     NString *source=n_string_new("");
	     n_string_append_printf(source,"%s=%s",fileName,content);
	     n_string_append(source,COLLECT_SPERATOR);
	     saveData(self,NULL,source->str,1);
 	     n_string_free(source,TRUE);
	   }else{
		 saveData(self,NULL,NULL,1);
	   }
}

/**
 * 保存非类中的泛型调用
 * 在.c编译完后调用
 */
void generic_file_save_out_func_call(GenericFile *self,char *content)
{
        initLockFile(self);
	   char *varName=createFuncCallVarName();
	   n_info("编译完成后，保存非本类中的泛型函数调用 变量名：%s 内容:%s\n",varName,content);
	   if(content!=NULL){
	     NString *source=n_string_new("");
	     n_string_append_printf(source,"%s=%s",varName,content);
	     n_string_append(source,COLLECT_SPERATOR);
	     saveData(self,NULL,source->str,2);
 	     n_string_free(source,TRUE);
	   }else{
		 saveData(self,NULL,NULL,2);
	   }
	   n_free(varName);
}

/**
 * _Z7AObject7AObjectEPN7AObjectE所在函数
 * 0 不是泛型函数 1 是泛型函数
 * _test_AObject__inner_generic_func_1_create_block_var=_Z7AObject7AObjectEPN7AObjectE$WWtx$0$WWtx$ void _test_AObject__inner_generic_func_1(test_AObject *self,int txyz)
 {
 printf ( "abcd--eee--" ) ;

 }
 */
static char ** reloveBlock(char *sysName,char *content)
{
	  char *fname=generic_util_create_block_func_name(sysName,-1);//-1时返回的字符串不包括数字
	  NString *cp=n_string_new(content);
	  int pos=n_string_indexof(cp,fname);
	  NString *sub=n_string_substring(cp,pos+strlen(fname));
	  pos=n_string_indexof(sub,"_");
	  NString *number=n_string_substring_from(sub,0,pos);//获取到泛型块函数的序号
	  pos=n_string_indexof(sub,"=");
	  NString *func=n_string_substring(sub,pos+1);
	  char **re=(char **)n_new(char,3);
	  re[0]=n_strdup(number->str);
	  re[1]=n_strdup(func->str);
      re[2]=NULL;
	  n_string_free(cp,TRUE);
	  n_string_free(sub,TRUE);
	  n_string_free(number,TRUE);
	  n_string_free(func,TRUE);
	  n_free(fname);
	  return re;
}

static  void checkBlockOrder(NPtrArray *array)
{
    int i;
    for(i=0;i<array->len;i++){
    	char **re=(char **)n_ptr_array_index(array,i);
    	if(atoi(re[0])!=i+1){
    		n_error("块的序列号不正确:%s %d\n",re[0],i+1);
    	}
    }
}

/**
 * _test_AObject__inner_generic_func_1_create_block_var=_Z7AObject7AObjectEPN7AObjectE$WWtx$0$WWtx$ void _test_AObject__inner_generic_func_1(test_AObject *self,int txyz)
 {
 printf ( "abcd--eee--" ) ;

 }
 */
static NPtrArray *readGenericBlock(GenericFile *self,char *sysName)
{
	  char buffer[GENERIC_FILE_SIZE];
	  NPtrArray *array=n_ptr_array_new_with_free_func(n_strfreev);
	  int re = link_file_read(self->blockFile,buffer, GENERIC_FILE_SIZE);
	  if(re>0){
		  buffer[re]='\0';
		  nchar **items=n_strsplit(buffer,COLLECT_SPERATOR,-1);
		  int length= n_strv_length(items);
		  int i,j;
		  char *fname=generic_util_create_block_func_name(sysName,-1);//-1时返回的字符串不包括数字
		  for(i=0;i<length;i++){
			 char *tx=items[i];
			 NString *cp=n_string_new(tx);
			 if(n_string_starts_with(cp,fname)){ //_test_AObject__inner_generic_func_1_create_block_var
				 char **re=reloveBlock(sysName,tx);
				 n_ptr_array_add(array,re);
			 }
			 n_string_free(cp,TRUE);
		  }
		  n_strfreev(items);
	  }
	  if(array->len==0){
		  n_ptr_array_unref(array);
		  return NULL;
	  }
	  return array;
}


BlockContent *generic_file_get_block_content(GenericFile *self,char *sysName)
{
       initLockFile(self);
	  int fd=link_file_lock(self->blockFile);
	  NPtrArray *array=readGenericBlock(self,sysName);
	  link_file_unlock(fd);
	  printf("generic_file_get_block_content 00 %p %s\n",array,sysName);
	  if(array==NULL)
		  return NULL;
	  checkBlockOrder(array);
	  BlockContent *bc=n_slice_new(BlockContent);
	  bc->blocksCount=array->len;
	  bc->sysName=n_strdup(sysName);
	  printf("generic_file_get_block_content 11 %p %d\n",array,array->len);
	  int i;
	  for(i=0;i<array->len;i++){
		  //_Z7AObject7AObjectEPN7AObjectE$WWtx$0$WWtx$ void _test_AObject__inner_generic_func_1(test_AObject
		  char **r=(char **)n_ptr_array_index(array,i);
		  nchar **items=n_strsplit(r[1],NEW_OBJECT_GENERIC_SPERATOR,-1);
		  BlockDetail *detail=n_slice_new(BlockDetail);
		  detail->belongFunc=n_strdup(items[0]);
		  detail->isFuncGeneric=atoi(items[1]);
		  detail->codes=n_strdup(items[2]);
		  bc->content[i]=detail;
		  n_strfreev(items);
	  }
	  n_ptr_array_unref(array);
	  return bc;
}

/**
 * 所有new$泛型对象的存储格式如下
 * test_AObject$WWtx$float0$WWtx$
 * float0最后的0表示指针数量
 */



static void freeGenericFuncCallInfo_cb(GenericFunCallInfo *callInfo)
{
	if(callInfo==NULL)
		return;
    int i;
    for(i=0;i<100;i++){
    	GenericDefineInfo *info=callInfo->infos[i];
    	if(info==NULL)
    		break;
    	if(info->name)
    		n_free(info->name);
    	n_slice_free(GenericDefineInfo,info);
    }
    n_free(callInfo->sysName);
    n_free(callInfo->funcName);
    n_slice_free(GenericFunCallInfo,callInfo);
}


/**
 * BV@hg8#test_Abc_create_undefine_var=test_Abc$WWtx$test_AObject$WWtx$E0$WWtx$
 */
static NPtrArray *readUndefineOrDefineNewObj(GenericFile *self,char *belongSysName,nboolean undefine)
{
	  char buffer[GENERIC_FILE_SIZE];
	  NPtrArray *array=NULL;
	  int re = link_file_read(self->blockFile,buffer,GENERIC_FILE_SIZE);
	  char     *varName=NULL;
	  if(undefine)
	     varName=generic_util_create_undefine_new_object_var_name(belongSysName);
	  else
		 varName=generic_util_create_define_new_object_var_name(belongSysName);
	  if(re>0){
		  buffer[re]='\0';
		  nchar **items=n_strsplit(buffer,COLLECT_SPERATOR,-1);
		  int length= n_strv_length(items);
		  int i,j;
		  for(i=0;i<length;i++){
			 char *tx=items[i];
			 NString *cp=n_string_new(tx);
			 if(n_string_starts_with(cp,varName)){
				 array=generic_storage_relove_undefine_or_define_obj(tx,varName,undefine);
				 n_string_free(cp,TRUE);
				 break;
			 }
			 n_string_free(cp,TRUE);
		  }
		  n_strfreev(items);
	  }
	  n_free(varName);
	  return array;
}

/**
 * 获取所属类的未定义的对象
 */
NPtrArray    *generic_file_get_undefine_new_object(GenericFile *self,char *belongSysName)
{
       initLockFile(self);
	  int fd=link_file_lock(self->blockFile);
	  NPtrArray *array=readUndefineOrDefineNewObj(self,belongSysName,TRUE);
	  link_file_unlock(fd);
	  printf("generic_file_get_undefine_new_object 00 是否有未定义泛型：%p %s\n",array,belongSysName);
	  return array;
}

/**
 * 获取所属类中泛型定义的对象和类所在文件中的泛型定义类
 */
NPtrArray    *generic_file_get_define_new_object(GenericFile *self,char *belongSysName)
{
      initLockFile(self);
	  int fd=link_file_lock(self->blockFile);
	  NPtrArray *array=readUndefineOrDefineNewObj(self,belongSysName,FALSE);
	  link_file_unlock(fd);
	  printf("generic_file_get_define_new_object 00 是否有未定义泛型：%p %s\n",array,belongSysName);
	  return array;
}

static void fillFuncCall(char *content,NPtrArray *array,char *sysName,char *func)
{
	char **genStrs=n_strsplit(content,NEW_OBJECT_GENERIC_SPERATOR,-1);
	int genCount=n_strv_length(genStrs);
	if(genCount==0)
		return;
	char *belongSysClassName=genStrs[0];
	char *funcName=genStrs[1];
	if(strcmp(belongSysClassName,sysName) || strcmp(funcName,func)){
		n_strfreev(genStrs);
		return;
	}
	GenericFunCallInfo *callInfo=(GenericFunCallInfo *)n_slice_new0(GenericFunCallInfo);
	callInfo->sysName=n_strdup(belongSysClassName);
	callInfo->funcName=n_strdup(funcName);
	int count=0;
	int i=0;
	for(i=2;i<genCount;i++){
		char *gen=genStrs[i];
        int strLen=strlen(gen);
		if(gen!=NULL && strLen>0){
		   char rr[strlen(gen)-1];
		   memcpy(rr,gen,strlen(gen)-1);
		   rr[strlen(gen)-1]='\0';
		   char p=gen[strlen(gen)-1];
		   int pointer=p-48;
		   GenericDefineInfo *info=n_slice_new(GenericDefineInfo);
		   info->name=n_strdup(rr);
		   info->pointer=pointer;
		   callInfo->infos[count++]=info;
		}
	}
	callInfo->infos[count]=NULL;
	callInfo->count=count;
	n_ptr_array_add(array,callInfo);
	n_strfreev(genStrs);
}

static NPtrArray *reloveFuncCall(char *content,char *varName,char *belongSysName,char *func)
{
	  NString *cp=n_string_new(content);
	  int pos=n_string_indexof(cp,varName);
	  NString *sub=n_string_substring(cp,pos+strlen(varName));
	  printf("reloveFuncCall 00 %s\n",sub->str);
	  pos=n_string_indexof(sub,"=");
	  NString *objStr=n_string_substring(sub,pos+1);
	  printf("reloveFuncCall 11 %s\n",sub->str);
	  char *result=n_strdup(objStr->str);
	  n_string_free(cp,TRUE);
	  n_string_free(sub,TRUE);
	  n_string_free(objStr,TRUE);
	  char **items=n_strsplit(result,"\n",-1);
	  int len=n_strv_length(items);
	  if(len<=0){
		  n_error("获取当前文件所有的泛型函数调用时，出现空的 %s %s\n",content,varName);
	       return NULL;
	  }
	  NPtrArray *array=n_ptr_array_new_with_free_func(freeGenericFuncCallInfo_cb);
      int i;
      for(i=0;i<len;i++){
    	  fillFuncCall(items[i],array,belongSysName,func);
      }
      if(array->len==0){
    	  n_ptr_array_unref(array);
    	  return NULL;
      }
      return array;
}

/**
*BV@hg8#test_AObject_func_generic_call=test_AObject$WWtx$_Z7AObject7setDataEPN7AObjectE$WWtx$int0
 */
static NPtrArray *readFuncGenericCall(GenericFile *self,char *belongSysName,char *func,char *varName)
{
	  char buffer[GENERIC_FILE_SIZE];
	  NPtrArray *array=NULL;
	  int re = link_file_read(self->blockFile,buffer, GENERIC_FILE_SIZE);
	  if(re>0){
		  buffer[re]='\0';
		  nchar **items=n_strsplit(buffer,COLLECT_SPERATOR,-1);
		  int length= n_strv_length(items);
		  int i,j;
		  for(i=0;i<length;i++){
			 char *tx=items[i];
			 NString *cp=n_string_new(tx);
			 if(n_string_starts_with(cp,varName)){ //
				array=reloveFuncCall(tx,varName,belongSysName,func);
				n_string_free(cp,TRUE);
				break;
			 }
			 n_string_free(cp,TRUE);
		  }
		  n_strfreev(items);
	  }
	  return array;
}

/**
 * 获取调用类belongSysName中的泛型函数的泛型定义
 */
NPtrArray  *generic_file_get_func_generic_call(GenericFile *self,char *belongSysName,char *genFunc,nboolean inner)
{
       initLockFile(self);
	  int fd=link_file_lock(self->blockFile);
	  char *varName=NULL;
	  if(inner)
		  varName=generic_util_create_func_generic_call_var_name(belongSysName);
	  else
	      varName=createFuncCallVarName();
	  NPtrArray *array=readFuncGenericCall(self,belongSysName,genFunc,varName);
	  link_file_unlock(fd);
	  return array;
}

/**
 * 获取类所在的文件
 */
char  *generic_file_get_file_class_located(GenericFile *self,char *sysName)
{
          initLockFile(self);

	      int fd=link_file_lock(self->blockFile);
		  char buffer[GENERIC_FILE_SIZE];
		  int re = link_file_read(self->blockFile,buffer, GENERIC_FILE_SIZE);
		  char  *result=NULL;
		  char *key=generic_util_create_class_key_in_file(sysName);
		  if(re>0){
			  buffer[re]='\0';
			  nchar **items=n_strsplit(buffer,COLLECT_SPERATOR,-1);
			  int length= n_strv_length(items);
			  int i,j;
			  for(i=0;i<length;i++){
				 char *tx=items[i];
				 NString *cp=n_string_new(tx);
				 if(n_string_starts_with(cp,key)){ //
					  int pos=n_string_indexof(cp,"=");
					  NString *fileName=n_string_substring(cp,pos+1);
					  result=n_strdup(fileName->str);
					  n_string_free(fileName,TRUE);
					  n_string_free(cp,TRUE);
					  break;
				 }
				 n_string_free(cp,TRUE);
			  }
			  n_strfreev(items);
		  }
		  n_free(key);
		  link_file_unlock(fd);
		  return result;
}

GenericFile *generic_file_get()
{
	static GenericFile *singleton = NULL;
	if (!singleton){
		 singleton =n_slice_alloc0 (sizeof(GenericFile));
		 genericFileInit(singleton);
	}
	return singleton;
}


