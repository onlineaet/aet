static tree aet_copy_statement_list(tree *stmtList)
{
	  tree result=NULL_TREE;
	  tree_stmt_iterator oi;
	  oi = tsi_start (*stmtList);
	  nboolean find=FALSE;
	  for (; !tsi_end_p (oi); tsi_next (&oi)){
	       tree stmt = tsi_stmt (oi);
	       if (TREE_CODE (stmt) == DECL_EXPR ){
	           printf("aet_copy_statement_list 00 遇到一个变量声明。\n");
	       	   tree var=DECL_EXPR_DECL (stmt);
	       	   nboolean is0=isClass(var);
	       	   if(is0){
	       		   printf("aet_copy_statement_list 11 变量声明是一个类对象。\n");
	       		   aet_print_tree_skip_debug(var);
	       		   tree call=DECL_INITIAL (var);
	       		   if (call && TREE_CODE (call)==CALL_EXPR){
	       			   printf("变量声明是一个类对象。并且有初始化。\n");
	       			   //aet_print_tree_skip_debug(DECL_INITIAL (var));
	       			   if(isClass(call)){
	       				   printf("给变量加入clearup变量声明是一个类对象。并且有初始化。\n");
	       				   //copy_statement_list(&dp->currentStmtList,t);
	       			   }
	       		   }else{
	       			   char *varName=IDENTIFIER_POINTER(DECL_NAME(var));
	       			   if(!strcmp(varName,"zcys")){
	       				   printf("aet_copy_statement_list 22 给变量加入clearup变量声明是一个类对象。并且有初始化xxxxxx。\n");
	       				   //copy_statement_list(&dp->currentStmtList,t);
	       				   find=TRUE;
	       				   break;
	       			   }
	       		   }
	       	   }
	       }
	    }
	    if(find){
	    	result=copy_statement_listabc(stmtList);
	    }
	    return result;
}




struct try_finally_data{
	tree prev;
	tree tryFinally;
	tree stmtList;
	hash_set<tree> *visited;
};
static tree walkTryFinally_cb(tree *tp, int *walk_subtrees, void *data)
{
	   struct try_finally_data *dp = (struct try_finally_data *)data;
	   printf("walkTryFinally_cb----\n");
	   tree t = *tp;
	   aet_print_tree_skip_debug(t);

	   if (TYPE_P (t)){
	        *walk_subtrees = 0;
       }else if(TREE_CODE(t)==STATEMENT_LIST){
	         tree stmtList=t;
    	     append_to_statement_list_force (dp->tryFinally, &stmtList);
       }


	   if (dp->visited->add (*tp))
	    *walk_subtrees = 0;
	   return NULL_TREE;

}


/**
 * 给以下两种对象变量加上cleanup
 * Abc fb=getAbc();
 * Abc fb;
 * fb=getAbc();
 */
static tree addCleanup_cb (tree *tp, int *walk_subtrees, void *data)
{
   struct add_cleanup_data *dp = (struct add_cleanup_data *)data;
   printf("addCleanup_cb----\n");

   tree t = *tp;
	  aet_print_tree_skip_debug(t);

   if (TYPE_P (t))
      *walk_subtrees = 0;
   else if (TREE_CODE (t) == BIND_EXPR)
      walk_tree (&BIND_EXPR_BODY (t), addCleanup_cb, data, NULL);
   else if (TREE_CODE (t) == CALL_EXPR ){
	  nboolean is0=isClass(t);
	  printf("CALL_EXPR 00000 %d\n",is0);
	  if(is0){
		  aet_print_tree_skip_debug(t);
	  }
   }else if(TREE_CODE(t)==STATEMENT_LIST){
          // dp->currentStmtList=t;
		  tree result= aet_copy_statement_list(&t);
		  if(result!=NULL_TREE){
			  *tp=result;
		      *walk_subtrees = 0;
		  }
   }else if (TREE_CODE (t) == RETURN_EXPR) {
	    *walk_subtrees = 0;

   }else if(TREE_CODE(t)==MODIFY_EXPR){
	  tree lhs=TREE_OPERAND (t, 0);
	  tree rhs=TREE_OPERAND (t, 1);
	  nboolean is0=isClass(lhs);
	  nboolean is1=isClass(rhs);
	  printf("MODIFY_EXPR 00000 %d %d\n",is0,is1);
	  if(is0 && is1){
		  if (TREE_CODE (rhs)==CALL_EXPR){
			   printf("变量声明是一个类对象。并且被函数调用赋值。\n");
			   aet_print_tree_skip_debug(t);
			   copy_statement_list(&dp->currentStmtList,t);
		  }
	  }
   }else if (TREE_CODE (t) == DECL_EXPR ){
       printf("addCleanup_cb 遇到一个变量声明。\n");
	   tree var=DECL_EXPR_DECL (t);
	   nboolean is0=isClass(var);
	   if(is0){
		   printf("变量声明是一个类对象。\n");
		   aet_print_tree_skip_debug(var);
		   tree call=DECL_INITIAL (var);
		   if (call && TREE_CODE (call)==CALL_EXPR){
			   printf("变量声明是一个类对象。并且有初始化。\n");
			   //aet_print_tree_skip_debug(DECL_INITIAL (var));

			   if(isClass(call)){
				   printf("给变量加入clearup变量声明是一个类对象。并且有初始化。\n");
				   copy_statement_list(&dp->currentStmtList,t);
			   }
		   }else{
			   char *varName=IDENTIFIER_POINTER(DECL_NAME(var));
			   if(!strcmp(varName,"zcys")){
				   printf("给变量加入clearup变量声明是一个类对象。并且有初始化xxxxxx。\n");
				   //copy_statement_list(&dp->currentStmtList,t);
//				   tree tryFinally=setClearup(var);
//                   //*tp=tryFinally;
//                   struct try_finally_data data;
//                   data.prev=t;
//                   data.tryFinally=tryFinally;
//                   data.stmtList=dp->currentStmtList;
//                   data.visited = new hash_set<tree>;
//                   walk_tree (&dp->currentStmtList, walkTryFinally_cb, &data, NULL);
//                   delete data.visited;
//                   *walk_subtrees = 0;
			   }

		   }
	   }
   }
   if (dp->visited->add (*tp))
    *walk_subtrees = 0;
   return NULL_TREE;
}

/**
 * 为函数返回值是aet class加入cleanup
 */
static void finalize_add_cleanup(ObjectReturn *self,tree fndecl)
{
  struct add_cleanup_data data;
  walk_tree_fn func;
  data.currentStmtList = NULL;
  printf("finalize_add_cleanup 00\n");
  data.visited = new hash_set<tree>;
  func=addCleanup_cb;
  walk_tree (&DECL_SAVED_TREE (fndecl), func, &data, NULL);
  delete data.visited;
  printf("finalize_add_cleanup overover\n");

}


