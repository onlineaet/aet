static tree createSelfParmDecl(c_parser *parser,ClassName *className)
{
	tree recordId=aet_utils_create_ident(className->sysName);
	tree record=lookup_name(recordId);
	if(!record || record==NULL_TREE || record==error_mark_node){
		printf("没有找到 %s\n",className);
		error("没有找到 class");
	}

	  printf("createSelfParmDecl 00  %s\n",get_tree_code_name(TREE_CODE(record)));
		tree recordType=TREE_TYPE(record);
		  printf("createSelfParmDecl 11  %p\n",recordType);

		  printf("createSelfParmDecl 22  %s\n",get_tree_code_name(TREE_CODE(recordType)));

	tree pointer=build_pointer_type(recordType);
    location_t loc = c_parser_peek_token (parser)->location;
    tree parmName=aet_utils_create_ident("self");
    tree decl = build_decl (loc,PARM_DECL, parmName, pointer);
    return decl;
}

///////////////////////////来自genericcall.c-------------------------------------

/////////////////生成参数 FuncGenParmInfo tempFgpi1234的实参-----------------

static tree getAgiRecord()
{
	 tree aetGenericInfo=aet_utils_create_ident(AET_GENERIC_INFO_STRUCT_NAME);
	 tree record=lookup_name(aetGenericInfo);
	 return record;
}

/**
 * FuncGenParmInfo 有数组	aet_generic_info pms[10];
 * bindBarDecl:FuncGenParmInfo的变量声明 info
 * arrayElementSubScreipt:pms的下标
 * agiFieldName:aet_generic_info的域名
 */
static tree createComponentRef(location_t loc,tree bindVarDecl,int arrayElementSubScreipt,char *agiFieldName)
{
    tree genericIndex=build_int_cst(integer_type_node,arrayElementSubScreipt);
    tree record=getAgiRecord();
    tree parentIdent=aet_utils_create_ident("pms");
    tree parentComponentRef = build_component_ref (loc,bindVarDecl,parentIdent, loc);//@104 完成 //生成info.pms
	tree arrayRef = build4 (ARRAY_REF, TREE_TYPE(record), parentComponentRef, genericIndex, NULL_TREE,NULL_TREE);
    tree ident=aet_utils_create_ident(agiFieldName);
	tree componentRef = build_component_ref (loc,arrayRef,ident, loc);//@104 完成
	return componentRef;
}

/**
 * strcpy(dest,src)的两个参数
 */
static tree createStrcpyParm(tree parmType,tree componentRef)
{
    unsigned HOST_WIDE_INT w1;
    w1=0;
    tree indextype= build_index_type (build_int_cst (integer_type_node, w1));
	tree arrayType=build_array_type(integer_type_node,indextype);// 对应 @103 type
	tree addExprType_ArrayType=build_pointer_type(arrayType);
	tree op0 = build1 (ADDR_EXPR, addExprType_ArrayType, componentRef);// @104 op component_ref
    tree fnParm1 = build1 (NOP_EXPR, parmType,op0);//@47 strcpy的第一个参数
    return fnParm1;
}


/**
 *  testxx(({FuncGenParmInfo info;
     strcpy(info.pms[0].typeName,"abcd");
     info.pms[0].genericName=89;
     info.pms[0].type=1;
     info.pms[0].pointerCount=-1;
     info.pms[0].size=4;
     strcpy(info.pms[1].typeName,"rtyz");
     info.pms[1].genericName=29;
     info.pms[1].type=1;
     info.pms[1].pointerCount=-1;
     info.pms[1].size=4;
	 info;}),5);
	 return 0;
 */

static void addStmt(int arrayElementSubScreipt,char *genStr,tree bindVarDecl,tree actualParmType,tree stmtList)
{
    location_t loc=input_location;
	tree stmt1Type=build_pointer_type(integer_type_node);//@45 type
    tree fn = builtin_decl_implicit (BUILT_IN_STRCPY);//@46
	// strcpy(info.pms[0].typeName,"abcd");
    {//@74 是一个addr_expr表达式 类型@103 是一个array_type
 	  tree componentRef=createComponentRef(loc,bindVarDecl,arrayElementSubScreipt,"typeName");
 	  tree fnParm1=createStrcpyParm(stmt1Type,componentRef);
	  tree strcst=createStringCst(actualParmType); //op0 @107
	  tree fnParm2=createStrcpyParm(stmt1Type,strcst);
	  tree stmt1 = build_call_expr (fn, 2, fnParm1,fnParm2);
	  append_to_statement_list_force (stmt1, &stmtList);
    }
    //info.pms[0].genericName=89;生成第二条语句
	{
	   tree componentRef=createComponentRef(loc,bindVarDecl,arrayElementSubScreipt,"genericName");
	   unsigned HOST_WIDE_INT value;
	   value=genStr[0];
	   tree rvalue=build_int_cst (integer_type_node, value);
	   tree stmt2 = build_modify_expr (loc, componentRef, TREE_TYPE(rvalue),NOP_EXPR,0,rvalue,TREE_TYPE(rvalue));
	   append_to_statement_list_force (stmt2, &stmtList);
	}
    //info.pms[0].type=1;
	{
	   tree componentRef=createComponentRef(loc,bindVarDecl,arrayElementSubScreipt,"type");
	   int type=generic_util_get_generic_type(actualParmType);
	   printf("type is ----%d\n",type);
	   if(type==-1){
		   n_warning("找不到类型对应的泛型。%s",get_tree_code_name(TREE_CODE(actualParmType)));
	   }
	   unsigned HOST_WIDE_INT value;
	   value=type;
	   tree rvalue=build_int_cst (integer_type_node, value);
	   tree stmt2 = build_modify_expr (loc, componentRef, TREE_TYPE(rvalue),NOP_EXPR,0,rvalue,TREE_TYPE(rvalue));
	   append_to_statement_list_force (stmt2, &stmtList);
	}
    //info.pms[0].pointerCount=-1;
	{
	   tree componentRef=createComponentRef(loc,bindVarDecl,arrayElementSubScreipt,"pointerCount");
	   int pointerCount=class_util_get_pointers(actualParmType);
	   pointerCount=pointerCount==0?-1:pointerCount;
	   unsigned HOST_WIDE_INT value;
	   value=pointerCount;
	   tree rvalue=build_int_cst (integer_type_node, value);
	   tree stmt2 = build_modify_expr (loc, componentRef, TREE_TYPE(rvalue),NOP_EXPR,0,rvalue,TREE_TYPE(rvalue));
	   append_to_statement_list_force (stmt2, &stmtList);
	}
    //info.pms[1].size=4;
	{
	   tree componentRef=createComponentRef(loc,bindVarDecl,arrayElementSubScreipt,"size");
	   tree value=c_sizeof(loc,actualParmType);
	   tree rvalue=value;
	   tree stmt2 = build_modify_expr (0, componentRef, TREE_TYPE(rvalue),NOP_EXPR,0,rvalue,TREE_TYPE(rvalue));
	   append_to_statement_list_force (stmt2, &stmtList);
	}
}

/**
 * 创建 ({FuncGenParmInfo info;temp.count=5;&info;})
 * 但是 -O2 优化后 info是乱的，所以加入volatile.
 * 但还是出错，不了解如何给变量加修饰 volatile ，改为用代码编译
 * 从genericcall.c移走到backupkey.backup
 */
static tree createFuncGenParmInfo(int genericCount,tree *actualParmTypes,char **ids)
{
    location_t loc=input_location;
	tree type= generic_util_get_fgpi_record_type();

	//type = build_qualified_type (type, TYPE_QUALS (type) | TYPE_QUAL_VOLATILE);
    // TREE_TYPE (decl) = t;
	//type = build_qualified_type (type, TYPE_QUAL_VOLATILE);
    //type = c_build_qualified_type (type, TYPE_QUAL_VOLATILE);
    //type = = change_qualified_type (type, TYPE_QUAL_VOLATILE);

    printf("createFuncGenParmInfo vvv eeeexxxeeexxxcccccccc\n");
	tree varDecl=build_decl(loc, VAR_DECL, NULL_TREE, type);
	DECL_ARTIFICIAL (varDecl)=1;
	TREE_USED (varDecl)=1;
    tree bindVarDecl = build_decl (0,VAR_DECL,aet_utils_create_ident("info"), type);
	TREE_USED (bindVarDecl)=1;
	//bindVarDecl = pushdecl (bindVarDecl);
	//finish_decl (bindVarDecl, loc, NULL_TREE,type, NULL_TREE);
	DECL_EXTERNAL(bindVarDecl)=0;
	TREE_STATIC(bindVarDecl)=0;
	TREE_PUBLIC(bindVarDecl)=0;
	DECL_CONTEXT(bindVarDecl)=current_function_decl;

	tree stmtList=alloc_stmt_list();
	tree stmt0 = build_stmt (loc, DECL_EXPR, void_type_node);
	append_to_statement_list_force (stmt0, &stmtList);
	int i;
	for(i=0;i<genericCount;i++){
		char *genStr=ids[i];
		tree actualType=actualParmTypes[i];
	    addStmt(i,genStr,bindVarDecl,actualType,stmtList);
	}
	tree stmt3 = build_modify_expr (loc, varDecl, void_type_node,NOP_EXPR,0,bindVarDecl,TREE_TYPE(bindVarDecl));
	append_to_statement_list_force (stmt3, &stmtList);
    tree bind = build3 (BIND_EXPR, void_type_node, bindVarDecl, stmtList, NULL_TREE);
    tree target = build4 (TARGET_EXPR, build_pointer_type(type), varDecl, bind, NULL_TREE, NULL_TREE);
   // aet_print_tree(target);
    return target;
}



//////////////----------------------------来自classimpl.c 创建静态数组变量-----
/**
 * 编译 -O2 会优化掉没有使用的静态变量，
 * 但如果定义如下，就不会
 * static  __attribute__((used))  char tyxy[]="asss";
 *  TREE_STATIC (decl) = 1;
    TREE_READONLY (decl) = 0;
    DECL_ARTIFICIAL (decl) = 0;
	DECL_CONTEXT(decl)=NULL_TREE;
    DECL_EXTERNAL(decl)=0;
	TREE_PUBLIC(decl)=0;
	DECL_READ_P (decl) = 1;
	TREE_USED (decl)=1;
    DECL_PRESERVE_P (decl) = 1;
    特别是DECL_PRESERVE_P=1很重要，参考自c-attribs.c handle_used_attribute
    创建的变量不能是指针。形如:static  __attribute__((used))  char tyxy[]="asss";
 */
static tree createGlobalGenericVar(ClassImpl *self, char *varName,char *codes)
{
	c_parser *parser=self->parser;
	location_t  loc = input_location;
	tree id=aet_utils_create_ident(varName);
	size_t length = strlen (codes);
	printf("createGlobalBlockVar ----%s %s\n",varName,codes);
    tree decl, type, init;
    //type = build_array_type (char_type_node,build_index_type (size_int (length)));
    type = build_array_type (char_type_node,NULL_TREE);
			  //build_index_type (size_int (length)));
    type = c_build_qualified_type (type, TYPE_QUAL_CONST);
    decl = build_decl (loc, VAR_DECL, id, type);
	DECL_ATTRIBUTES (decl) = tree_cons (get_identifier ("used"), NULL_TREE, DECL_ATTRIBUTES (decl));
    TREE_STATIC (decl) = 1;
    TREE_READONLY (decl) = 0;
    DECL_ARTIFICIAL (decl) = 0;
	DECL_CONTEXT(decl)=NULL_TREE;
    DECL_EXTERNAL(decl)=0;
	TREE_PUBLIC(decl)=0;
	DECL_READ_P (decl) = 1;
	TREE_USED (decl)=1;
    DECL_PRESERVE_P (decl) = 1;

    pushdecl (decl);
    init = build_string (length + 1, codes);
    TREE_TYPE (init) = type;
    DECL_INITIAL (decl) = init;
    TREE_USED (decl) = 1;
    DECL_PRESERVE_P (decl) = 1;
    TREE_STATIC (decl) = 1;
    TREE_READONLY (decl) = 0;
    DECL_ARTIFICIAL (decl) = 0;
	DECL_CONTEXT(decl)=NULL_TREE;
    DECL_EXTERNAL(decl)=0;
	TREE_PUBLIC(decl)=0;
	DECL_READ_P (decl) = 1;
    finish_decl (decl, loc, init, NULL_TREE, NULL_TREE);
    return decl;
}
/**
 * 保存5种类型的全局变量
 * 1.  _A_glb_GEN_name_test_AObject=2_0_1
 * 2:指块数
 * 0:指test_AObject类中未定泛型的对象“”new$ Abc<E>“这样的对象个数
 * 1:指test_AObject类中指定泛型的对象“”new$ Abc<int>“这样的对象个数
 */
static void createGenericGloablVar(ClassImpl *self,ClassName *className)
{
   int blockCount=block_mgr_get_block_count(block_mgr_get(),className);
   int undefineObject=block_mgr_get_undefine_newobj_count(block_mgr_get(),className);
   int defineObject=block_mgr_get_define_newobj_count(block_mgr_get(),className);

   char varName[256];
   generic_util_create_global_generic_var_name(className->sysName,varName);
   char content[256];
   sprintf(content,"%d_%d_%d",blockCount,undefineObject,defineObject);
   //char *_A_glb_GEN_name_test_AObject="0_0";
   createGlobalGenericVar(self,varName,content);
   /**
    * _test_AObject__inner_generic_func_1_create_block_var=_Z7AObject7AObjectEPN7AObjectE$WWtx$0$WWtx$ void _test_AObject__inner_generic_func_1(test_AObject *self,int txyz)
    {
    printf ( "abcd--eee--" ) ;

    }
    */
   int i;
   for(i=0;i<blockCount;i++){
	   char   **var=block_mgr_get_block_source(block_mgr_get(),className,i);
	   NString *value=n_string_new("");
	   n_string_append(value,"\"");
	   n_string_append(value,var[1]);
	   n_string_append(value,"\"");
	   createGlobalGenericVar(self,var[0],value->str);
	   n_strfreev(var);
	   n_string_free(value,TRUE);
   }
   //test_Abc_create_undefine_var "test_Abc$WWtx$test_AObject$WWtx$E0$WWtx$"
   char **undefineObjectSource=block_mgr_get_undefine_newobj_source_codes(block_mgr_get(),className);
   if(undefineObjectSource!=NULL){
	   NString *value=n_string_new("");
	   n_string_append(value,"\"");
	   n_string_append(value,undefineObjectSource[1]);
	   n_string_append(value,"\"");
	   createGlobalGenericVar(self,undefineObjectSource[0],value->str);
	   n_strfreev(undefineObjectSource);
	   n_string_free(value,TRUE);
   }

   //test_Abc_create_define_var ="com_ai_Matrix$WWtx$com_ai_DefaultMatrixModel$WWtx$float0$WWtx$"
   char **defineObjectSource=block_mgr_get_define_newobj_source_codes(block_mgr_get(),className);
   if(defineObjectSource!=NULL){
	   NString *value=n_string_new("");
	   n_string_append(value,"\"");
	   n_string_append(value,defineObjectSource[1]);
	   n_string_append(value,"\"");
	   createGlobalGenericVar(self,defineObjectSource[0],value->str);
	   n_strfreev(defineObjectSource);
	   n_string_free(value,TRUE);
   }

   char  **funcCall=block_mgr_get_func_generic_call_in_class(block_mgr_get(),className);
   if(funcCall!=NULL){
	   NString *value=n_string_new("");
	   n_string_append(value,"\"");
	   n_string_append(value,funcCall[1]);
	   n_string_append(value,"\"");
	   createGlobalGenericVar(self,funcCall[0],value->str);
	   n_strfreev(funcCall);
	   n_string_free(value,TRUE);
   }
   //保存类属于那个文件
   {
	   char *key=generic_util_create_class_key_in_file(className->sysName);
	   char *fileName=in_fnames[0];
	   NString *value=n_string_new("");
	   n_string_append(value,"\"");
	   n_string_append(value,fileName);
	   n_string_append(value,"\"");
	   createGlobalGenericVar(self,key,value->str);
	   n_free(key);
	   n_string_free(value,TRUE);
   }
}