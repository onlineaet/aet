static void fillFuncCall(char *content,NPtrArray *array,char *sysName,char *func)
{
	char **genStrs=n_strsplit(content,NEW_OBJECT_GENERIC_SPERATOR,-1);
	int genCount=n_strv_length(genStrs);
	if(genCount==0)
		return;
	char *belongSysClassName=genStrs[0];
	char *funcName=genStrs[1];
	if(strcmp(belongSysClassName,sysName) || strcmp(funcName,func)){
		n_strfreev(genStrs);
		return;
	}
	GenericFunCallInfo *callInfo=(GenericFunCallInfo *)n_slice_new0(GenericFunCallInfo);
	callInfo->sysName=n_strdup(belongSysClassName);
	callInfo->funcName=n_strdup(funcName);
	int count=0;
	int i=0;
	for(i=2;i<genCount;i++){
		char *gen=genStrs[i];
        int strLen=strlen(gen);
		if(gen!=NULL && strLen>0){
		   char rr[strlen(gen)-1];
		   memcpy(rr,gen,strlen(gen)-1);
		   rr[strlen(gen)-1]='\0';
		   char p=gen[strlen(gen)-1];
		   int pointer=p-48;
		   GenericDefineInfo *info=n_slice_new(GenericDefineInfo);
		   info->name=n_strdup(rr);
		   info->pointer=pointer;
		   callInfo->infos[count++]=info;
		}
	}
	callInfo->infos[count]=NULL;
	callInfo->count=count;
	n_ptr_array_add(array,callInfo);
	n_strfreev(genStrs);
}

static void freeGenericFuncCallInfo_cb(GenericFunCallInfo *callInfo)
{
	if(callInfo==NULL)
		return;
    int i;
    for(i=0;i<100;i++){
    	GenericDefineInfo *info=callInfo->infos[i];
    	if(info==NULL)
    		break;
    	if(info->name)
    		n_free(info->name);
    	n_slice_free(GenericDefineInfo,info);
    }
    n_free(callInfo->sysName);
    n_free(callInfo->funcName);
    n_slice_free(GenericFunCallInfo,callInfo);
}

NPtrArray *generic_lib_get_func_call(GenericLib *self,char *sysName,char *func)
{
	  GenericData *data=getGenericData(self,sysName);
	  if(data->funcCall==0)
		  return NULL;
	  char **items=n_strsplit(data->funcCall->codes,"\n",-1);
	  int len=n_strv_length(items);
	  if(len<=0){
		  n_error("获取当前文件所有的new$确定泛型的类时，出现空的 %s\n",sysName);
		  return NULL;
	  }
	  NPtrArray *array=n_ptr_array_new_with_free_func(freeGenericFuncCallInfo_cb);
	  int i;
	  for(i=0;i<len;i++){
    	  fillFuncCall(items[i],array,sysName,func);
	  }
	  if(array->len==0){
		  n_ptr_array_unref(array);
		  return NULL;
	  }
	  return array;
}

char  *generic_lib_get_file_class_located(GenericLib *self,char *sysName)
{
	  GenericData *data=getGenericData(self,sysName);
	  if(data==NULL)
		  return NULL;
	  return data->fileClassLocated;
}

static  int lockFile()
{
   char *lockFile=getSaveFile("genLibLock");
   int fd = open(lockFile, O_RDWR | O_TRUNC|O_CREAT | O_EXCL, 0666);
   if(fd<=0){
	  if(errno==EEXIST){
		  fd = open(lockFile, O_RDWR |O_TRUNC| O_EXCL, 0666);
	  }
	  if(fd<=0){
		n_error("打不开文件:%s error:%d %s\n",lockFile,errno,xstrerror(errno));
		return -1;
	  }
   }
   return fd;
}

static void unlockFile(int fd)
{
    close(fd);
}


#define SPERATOR "7@3zclei$"

static void save(GenericLib *self)
{
	int i;
	NString *files=n_string_new("");
	for(i=0;i<self->libPathArray->len;i++){
		char *item=n_ptr_array_index(self->libPathArray,i);
		n_string_append(files,item);
		n_string_append(files,"\n");
	}
	n_string_append(files,SPERATOR);
	n_string_append(files,"\n");
	for(i=0;i<self->fileNameArray->len;i++){
		char *item=n_ptr_array_index(self->fileNameArray,i);
		n_string_append(files,item);
		n_string_append(files,"\n");
    }
	char *saveFileName=getSaveFile(GENERIC_LIB_INDEX_FILE_NAME);
	FILE *fp = fopen(saveFileName, "w");
    if(!fp){
	  if(errno==17){
	    fp = fopen(saveFileName, "r+x");
	  }
	  if(!fp){
	    n_error("打不开文件----:%s error:%d %s\n",saveFileName,errno,xstrerror(errno));
	    return;
	 }
   }
   fwrite(files->str,1,files->len,fp);
   fclose(fp);
   n_string_free(files,TRUE);
}

static void importContent(GenericLib *self,char *content)
{
	 nchar **items=n_strsplit(content,SPERATOR,-1);
	 int length= n_strv_length(items);
	 if(length!=2){
		 n_error("泛型库文件是错的 genericlib.c");
	 }
	 nchar **libFiles=n_strsplit(items[0],"\n",-1);
	 length= n_strv_length(libFiles);
	 int i;
	 for(i=0;i<length;i++){
     	n_ptr_array_add(self->libPathArray,n_strdup(libFiles[i]));
	 }
	 nchar **lfiles=n_strsplit(items[1],"\n",-1);
	 length= n_strv_length(lfiles);
	 for(i=0;i<length;i++){
	   	n_ptr_array_add(self->fileNameArray,n_strdup(lfiles[i]));
	 }
	  n_strfreev(items);
	  n_strfreev(libFiles);
	  n_strfreev(lfiles);
}

/**
 * 读文件GENERIC_LIB_INDEX_FILE_NAME      "genericlib_index.tmp"
 * 如果不存在，则读aet_collect2_argv.txt把所有的库文件，保存
 * 在NPtrArray中，最后把NptrArray中的文件条目存在genericlib_index.tmp中
 * 在编译过程中，不用每次都打开库文件。
 * 加锁，在多个进程间互斥
 */
static void readFile(GenericLib *self){
	int fd=lockFile();
	char *saveFileName=getSaveFile(GENERIC_LIB_INDEX_FILE_NAME);
	FILE *fp = fopen(saveFileName, "r");
	if(fp){
		char buffer[10*1024];
		int re = fread(buffer, sizeof(char), 10*1024, fp);
		fclose(fp);
		if(re>0){
			buffer[re]='\0';
			importContent(self,buffer);
		}
	}else{
		readLibPath(self);
		save(self);
	}
	unlockFile(fd);
}

/**
 * 变量的名称是否存在库中
 */
nboolean  generic_lib_have_global_var(GenericLib *self,char *varName)
{
	char *fileName=NULL;
	char *globalValue=getGlobalValue(self,varName,&fileName);
	nboolean re=globalValue!=NULL;
	printf("generic_lib_have_global_var %s %s\n",globalValue,fileName);
	n_free(fileName);
	n_free(globalValue);
	return re;
}

