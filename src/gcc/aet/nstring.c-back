NString *n_string_append (NString     *string,
                 const nchar *val)
{
  return n_string_insert_len (string, -1, val, -1);
}


NString *n_string_append_len (NString *string,const nchar *val,nssize len)
{
  return n_string_insert_len (string, -1, val, len);
}


NString *n_string_append_c (NString *string,nchar c)
{
  n_return_val_if_fail (string != NULL, NULL);

  return n_string_insert_c (string, -1, c);
}


NString *n_string_append_unichar (NString  *string,nunichar  wc)
{
  n_return_val_if_fail (string != NULL, NULL);

  return n_string_insert_unichar (string, -1, wc);
}


NString *n_string_prepend (NString     *string,const nchar *val)
{
  return n_string_insert_len (string, 0, val, -1);
}


NString *n_string_prepend_len (NString     *string,const nchar *val,nssize       len)
{
  return n_string_insert_len (string, 0, val, len);
}


NString *n_string_prepend_c (NString *string,nchar    c)
{
  n_return_val_if_fail (string != NULL, NULL);

  return n_string_insert_c (string, 0, c);
}


NString *n_string_prepend_unichar (NString  *string,nunichar  wc)
{
  n_return_val_if_fail (string != NULL, NULL);

  return n_string_insert_unichar (string, 0, wc);
}


NString *n_string_insert (NString     *string,nssize       pos,const nchar *val)
{
  return n_string_insert_len (string, pos, val, -1);
}


NString *n_string_insert_c (NString *string,nssize   pos,   nchar    c)
{
  nsize pos_unsigned;

  n_return_val_if_fail (string != NULL, NULL);

  n_string_maybe_expand (string, 1);

  if (pos < 0)
    pos = string->len;
  else
    n_return_val_if_fail ((nsize) pos <= string->len, string);
  pos_unsigned = pos;

  /* If not just an append, move the old stuff */
  if (pos_unsigned < string->len)
    memmove (string->str + pos_unsigned + 1,
             string->str + pos_unsigned, string->len - pos_unsigned);

  string->str[pos_unsigned] = c;
  string->len += 1;
  string->str[string->len] = 0;
  string->strCount=n_utf8_strlen(string->str,-1);
  resetOptimize(string);
  return string;
}


NString *n_string_insert_unichar (NString  *string,nssize pos,nunichar  wc)
{
  nint charlen, first, i;
  nchar *dest;

  n_return_val_if_fail (string != NULL, NULL);

  /* Code copied from n_unichar_to_utf() */
  if (wc < 0x80)
    {
      first = 0;
      charlen = 1;
    }
  else if (wc < 0x800)
    {
      first = 0xc0;
      charlen = 2;
    }
  else if (wc < 0x10000)
    {
      first = 0xe0;
      charlen = 3;
    }
   else if (wc < 0x200000)
    {
      first = 0xf0;
      charlen = 4;
    }
  else if (wc < 0x4000000)
    {
      first = 0xf8;
      charlen = 5;
    }
  else
    {
      first = 0xfc;
      charlen = 6;
    }
  /* End of copied code */

  n_string_maybe_expand (string, charlen);

  if (pos < 0)
    pos = string->len;
  else
    n_return_val_if_fail ((nsize) pos <= string->len, string);

  /* If not just an append, move the old stuff */
  if ((nsize) pos < string->len)
    memmove (string->str + pos + charlen, string->str + pos, string->len - pos);

  dest = string->str + pos;
  /* Code copied from g_unichar_to_utf() */
  for (i = charlen - 1; i > 0; --i)
    {
      dest[i] = (wc & 0x3f) | 0x80;
      wc >>= 6;
    }
  dest[0] = wc | first;
  /* End of copied code */
  string->len += charlen;
  string->str[string->len] = 0;
  string->strCount=n_utf8_strlen(string->str,-1);
  resetOptimize(string);
  return string;
}


NString *n_string_overwrite (NString *string,nsize pos,const nchar *val)
{
  n_return_val_if_fail (val != NULL, string);
  return n_string_overwrite_len (string, pos, val, strlen (val));
}

NString *n_string_overwrite_len (NString *string,nsize pos,const nchar *val,nssize       len)
{
  nsize end;

  n_return_val_if_fail (string != NULL, NULL);

  if (!len)
    return string;

  n_return_val_if_fail (val != NULL, string);
  n_return_val_if_fail (pos <= string->len, string);

  if (len < 0)
    len = strlen (val);

  end = pos + len;

  if (end > string->len)
    n_string_maybe_expand (string, end - string->len);

  memcpy (string->str + pos, val, len);

  if (end > string->len)
    {
      string->str[end] = '\0';
      string->len = end;
    }
  string->strCount=n_utf8_strlen(string->str,-1);
  resetOptimize(string);
  return string;
}


NString *n_string_erase (NString *string,nssize   pos,nssize   len)
{
  nsize len_unsigned, pos_unsigned;

  n_return_val_if_fail (string != NULL, NULL);
  n_return_val_if_fail (pos >= 0, string);
  pos_unsigned = pos;

  n_return_val_if_fail (pos_unsigned <= string->len, string);

  if (len < 0)
    len_unsigned = string->len - pos_unsigned;
  else
    {
      len_unsigned = len;
      n_return_val_if_fail (pos_unsigned + len_unsigned <= string->len, string);

      if (pos_unsigned + len_unsigned < string->len)
        memmove (string->str + pos_unsigned,
                 string->str + pos_unsigned + len_unsigned,
                 string->len - (pos_unsigned + len_unsigned));
    }

  string->len -= len_unsigned;

  string->str[string->len] = 0;
  string->strCount=n_utf8_strlen(string->str,-1);
  resetOptimize(string);
  return string;
}


NString *n_string_ascii_down (NString *string)
{
  nchar *s;
  nint n;

  n_return_val_if_fail (string != NULL, NULL);

  n = string->len;
  s = string->str;

  while (n)
    {
      *s = n_ascii_tolower (*s);
      s++;
      n--;
    }

  return string;
}


NString *n_string_ascii_up (NString *string)
{
  nchar *s;
  nint n;

  n_return_val_if_fail (string != NULL, NULL);

  n = string->len;
  s = string->str;

  while (n)
    {
      *s = n_ascii_toupper (*s);
      s++;
      n--;
    }

  return string;
}


void n_string_append_vprintf (NString  *string,const nchar *format,va_list      args)
{
  nchar *buf;
  nint len;

  n_return_if_fail (string != NULL);
  n_return_if_fail (format != NULL);

  len = n_vasprintf (&buf, format, args);

  if (len >= 0)
    {
      n_string_maybe_expand (string, len);
      memcpy (string->str + string->len, buf, len + 1);
      string->len += len;
      n_free (buf);
    }
    string->strCount=n_utf8_strlen(string->str,-1);
    resetOptimize(string);
}


void n_string_vprintf (NString     *string,const nchar *format,va_list      args)
{
  n_string_truncate (string, 0);
  n_string_append_vprintf (string, format, args);
}


void n_string_printf (NString     *string, const nchar *format, ...)
{
  va_list args;
  n_string_truncate (string, 0);
  va_start (args, format);
  n_string_append_vprintf (string, format, args);
  va_end (args);
}


void n_string_append_printf (NString     *string,const nchar *format,...)
{
  va_list args;
  va_start (args, format);
  n_string_append_vprintf (string, format, args);
  va_end (args);
}

///2021-02-01


static nuint32   charAt(char *str,int strCount,int index)
{
	if ((index < 0) || (index >= strCount)) {
		n_warning("给定的位置超出字符的位置！index:%d strCount:%d \"%s\"",index,strCount,str);
		return 0;
	}
	char *re=n_utf8_offset_to_pointer(str,index);
	return n_utf8_get_char (re);
}

nuint32   n_string_char_at(NString *self,int index)
{
	return charAt(self->str,self->strCount,index);
}


static nboolean startsWith(NString *self,char *prefix,int preStrCount, int toffset)
{
	    int pc=preStrCount;
        if ((toffset < 0) || (toffset > self->strCount - pc))
            return FALSE;
        int to=toffset;
        int po=0;
        while (--pc >= 0) {
	  	    nuint32 svalue= n_string_char_at(self,to++);
	  	    nuint32 cvalue= charAt(prefix,preStrCount,po++);
            if (svalue != cvalue)
                return FALSE;
        }
        return TRUE;
}

nboolean n_string_starts_with_from(NString *self,const char  *prefix, int toffset)
{
	  int strCount=n_utf8_strlen(prefix,-1);
	  return startsWith(self,prefix,strCount,toffset);
}


 nboolean n_string_starts_with(NString *self,const char  *prefix)
 {
	 return n_string_starts_with_from(self,prefix,0);
 }

 static nuint32 getValue(char *str,int index)
 {
     char *re=n_utf8_offset_to_pointer  (str,index);
     nuint32  c = n_utf8_get_char (re);
     return c;
 }


 static int indexOf(NString *self,char *target, int targetCount,int fromIndex)
 {
	     char *source=self->str;
	     int sourceCount=self->strCount;
         if (fromIndex >= sourceCount)
             return (targetCount == 0 ? sourceCount : -1);
         if (fromIndex < 0)
             fromIndex = 0;
         if (targetCount == 0)
             return fromIndex;
         nboolean isAscii=n_str_is_ascii(target);
         nboolean srcIsAscii=FALSE;
		 int sourceOffset=0;
         if(self->indexOfOpt.fromIndex<=fromIndex && self->indexOfOpt.isAscii){
        	 srcIsAscii=TRUE;
        	 sourceOffset=self->indexOfOpt.offset;
        	 //printf("使用缓存的indexo信息:opt:fromIndex:%d %d\n",self->indexOfOpt.fromIndex,fromIndex);
         }else{
			 if(fromIndex>0){
				char *subSource=n_utf8_offset_to_pointer(source,fromIndex);
				srcIsAscii=n_str_is_ascii(subSource);
				if(srcIsAscii){
				   sourceOffset=subSource-source;
				   sourceOffset-=fromIndex;
				}
			 }else{
				srcIsAscii=n_str_is_ascii(source);
			 }
			 self->indexOfOpt.fromIndex=fromIndex;
			 self->indexOfOpt.isAscii=srcIsAscii;
			 self->indexOfOpt.offset=sourceOffset;
         }
       	 nuint32 first=isAscii?target[0]:getValue(target,0);
        // printf("indexOf ---sourceCount:%d srcIsAscii:%d isAscii:%d\n",sourceCount,srcIsAscii,isAscii);
         int max =  (sourceCount - targetCount);
         int i;
         for (i =  fromIndex; i <= max; i++) {
             /*查找每一个字符。 */
             nuint32  srcValue=srcIsAscii?source[i+sourceOffset]:getValue(source,i);
             if (srcValue != first) {
                     while (++i <= max && (srcIsAscii?source[i+sourceOffset]:getValue(source,i))!= first);
              }

             /* 找到第一个字符，现在在V2中查找 */
             if (i <= max) {
                 int j = i + 1;
                 int end = j + targetCount - 1;
                 int k;
                 for ( k = 1; j < end && (srcIsAscii?source[j+sourceOffset]:getValue(source,j))== (isAscii?target[k]:getValue(target,k)); j++, k++);

                 if (j == end) {
                     /* 找到整个字符. */
                     return i;
                 }
             }
         }
         return -1;
 }

 static int indexofFrom(NString *self, char *str,int fromIndex)
 {
	    return indexOf(self,str, n_utf8_strlen(str,-1), fromIndex);
 }

 int n_string_indexof_from(NString *self,const char *str,int fromIndex)
 {
     return indexofFrom(self, str,fromIndex);
 }

 int n_string_indexof(NString *self,const char *str)
 {
       return indexofFrom(self, str,0);
 }

 static int lastIndexOf(char *source, int sourceOffset, int sourceCount,
            char *target, int targetOffset, int targetCount, int fromIndex)
 {
        int rightIndex = sourceCount - targetCount;
        if (fromIndex < 0) {
            return -1;
        }
        if (fromIndex > rightIndex) {
            fromIndex = rightIndex;
        }
        /* 空字符总是匹配。 */
        if (targetCount == 0) {
            return fromIndex;
        }
        int strLastIndex = targetOffset + targetCount - 1;
        nuint32  strLastChar=getValue(target,strLastIndex);
       // char strLastChar = target[strLastIndex];
        int min = sourceOffset + targetCount - 1;
        int i = min + fromIndex;

        startSearchForLastChar:
        while (TRUE) {
            while (i >= min && getValue(source,i) != strLastChar) {
                i--;
            }
            if (i < min) {
                return -1;
            }
            int j = i - 1;
            int start = j - (targetCount - 1);
            int k = strLastIndex - 1;

            while (j > start) {
                if (getValue(source,j--) != getValue(target,k--)) {
                    i--;
                    goto startSearchForLastChar;
                }
            }
            return start - sourceOffset + 1;
        }
        return -1;
 }

 static int lastIndexofFrom(NString *self,char *str, int fromIndex)
 {
	    return lastIndexOf(self->str, 0,self->strCount,str, 0, n_utf8_strlen(str,-1), fromIndex);
 }


 static int lastIndexof(NString *self,char *str)
 {
        return lastIndexofFrom(self,str, self->strCount);
 }

 int n_string_last_indexof(NString *self,const char *str)
 {
        int re=lastIndexof(self,str);
        return re;
 }

 int n_string_last_indexof_from(NString *self,const char *str,int from)
 {
        int re=lastIndexofFrom(self,str,from);
        return re;
 }

 static NString *substring(NString  *self,int beginIndex,int endIndex)
 {
     if (beginIndex < 0) {
         n_warning("给定的位置超出字符的的长度！%d",beginIndex);
         return NULL;
     }
     if (endIndex > self->strCount) {
         n_warning("给定的位置超出字符的的长度！%d",endIndex);
         return NULL;
     }
     if (  endIndex-beginIndex<0) {
         n_warning("给定的位置超出字符的的长度！%d", endIndex-beginIndex);
         return NULL;
     }
    // char *out=g_utf8_substring(priv->str,beginIndex,endIndex);
     nchar *start, *end, *out;
     start = n_utf8_offset_to_pointer (self->str, beginIndex);
     end = n_utf8_offset_to_pointer (start, endIndex - beginIndex);
     out = n_malloc (end - start+1);
     memcpy (out, start, end - start);
     out[end - start] = '\0';
     //NString *e= n_string_new(out);太花时间了
//     NString *e= n_string_new(out);
//     n_free(out);
//     return e;
     NString *e = n_slice_new (NString);
     e->str=out;
     e->len=end - start;
     e->strCount=n_utf8_strlen(out,-1);
     e->allocated_len=e->len;
     resetOptimize(e);
     return e;
 }

 NString *n_string_substring_from(NString *self,int begin,int end)
 {
 	   return substring(self,begin,end);
 }

 NString *n_string_substring(NString *self,int begin)
 {
 	return n_string_substring_from(self,begin,self->strCount);
 }

 nboolean n_string_ends_with(NString *self,const char  *suffix)
 {
	  int strCount=n_utf8_strlen(suffix,-1);
	  int toffset=self->strCount-strCount;
	  return startsWith(self,suffix,strCount,toffset);
 }

 void n_string_trim(NString *self)
 {
      self->str=n_strstrip(self->str);
      self->len=strlen(self->str);
      self->strCount=n_utf8_strlen(self->str,-1);
      resetOptimize(self);
 }


 NString *n_string_sized_new (nsize dfl_size)
 {
   NString *self = n_slice_new (NString);
   self->allocated_len = 0;
   self->len   = 0;
   self->str   = NULL;
   n_string_maybe_expand (self, MAX (dfl_size, 2));
   self->str[0] = 0;
   self->strCount=0;
   resetOptimize(self);
   return self;
 }


 NString *n_string_new (const nchar *init)
 {
   NString *self;
   if (init == NULL || *init == '\0')
 	  self = n_string_sized_new (2);
   else{
       nint len;
       len = strlen (init);
       self = n_string_sized_new (len + 2);
       n_string_append_len (self, init, len);
       self->strCount=n_utf8_strlen(init,-1);
   }
   return self;
 }


 NString *n_string_new_len (const nchar *init,nssize       len)
 {
   NString *string;
   if (len < 0)
     return n_string_new (init);
   else{
       string = n_string_sized_new (len);
       if (init)
         n_string_append_len (string, init, len);
       return string;
   }
 }
