
#ifndef __GCC_GENERIC_LIB_H__
#define __GCC_GENERIC_LIB_H__


#include "../aet/nlib.h"
#include "classinfo.h"
#include "genericinfo.h"


typedef struct _GenericLib GenericLib;
/* --- structures --- */
struct _GenericLib
{
   NPtrArray *libPathArray;
   NPtrArray *fileNameArray;
   NHashTable *hashTable;

};


GenericLib   *generic_lib_get();
BlockContent *generic_lib_get_block_content(GenericLib *self,char *sysName);
NPtrArray    *generic_lib_get_undefine_obj(GenericLib *self,char *sysName);
NPtrArray    *generic_lib_get_func_call(GenericLib *self,char *sysName,char *func);
NPtrArray    *generic_lib_get_define_obj(GenericLib *self,char *sysName);
char         *generic_lib_get_file_class_located(GenericLib *self,char *sysName);
nboolean      generic_lib_have_global_var(GenericLib *self,char *varName);
NPtrArray    *generic_lib_get_match_var_from_file(GenericLib *self,char *varName,char *fileName);
char         *generic_lib_get_string(GenericLib *self,char *varName,char *fileName);


#endif

