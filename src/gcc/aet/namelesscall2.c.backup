/**
 * 函数返回值是一个类对象吗？适用以下语句
 * getRandom()->nextInt();
 * op是INDIRECT_REF，它的TREE_OPERAND(op,0)就是getRandom();
 */
static int getModel(tree op)
{
    if(TREE_CODE(op)==INDIRECT_REF){//说明是指针
        tree callOrNop=TREE_OPERAND(op,0);
        if(TREE_CODE(callOrNop)==CALL_EXPR){ //op是INDIRECT_REF，它的TREE_OPERAND(op,0)就是CALL_EXPR getRandom();
            tree type=TREE_TYPE(callOrNop);
            char *name=class_util_get_class_name(type);
            if(name!=NULL){
                return 1;
            }
        }else if(TREE_CODE(callOrNop)==NOP_EXPR){ ////op是INDIRECT_REF，它的TREE_OPERAND(op,0)就是NOP_EXPR (AObject*)getRandom();
            tree call=TREE_OPERAND(callOrNop,0);
            if(TREE_CODE(call)==CALL_EXPR){
                tree type=TREE_TYPE(callOrNop);
                char *name=class_util_get_class_name(type);
                if(name!=NULL){
                   return 2;
                }
            }
        }
    }else if(TREE_CODE(op)==COMPONENT_REF){//((RandomGenerator*)getRandom()) RandomGenerator是接口 opType是接口名
         tree indirectRef=TREE_OPERAND(op,0);
         tree opType=TREE_TYPE(op);
         char *name=class_util_get_class_name(opType);
         if(TREE_CODE(indirectRef)==INDIRECT_REF && name){
             tree callExpr=TREE_OPERAND(indirectRef,0);
             if(TREE_CODE(callExpr)==CALL_EXPR){
                 return 3;
             }
         }
    }else if(TREE_CODE(op)==CALL_EXPR){
        tree opType=TREE_TYPE(op);
        char *name=class_util_get_class_name(opType);
        if(name && TREE_CODE(opType)==RECORD_TYPE){
              return 4;
        }
    }
     return 0;
}

/**
 * 调用的是不是一个类中方法
 */
static nboolean isFieldDecl(tree op)
{
    if(TREE_CODE(op)==FIELD_DECL){
          tree type=TREE_TYPE(op);
          if(TREE_CODE(type)==POINTER_TYPE){
              type=TREE_TYPE(type);
              if(TREE_CODE(type)==FUNCTION_TYPE)
                  return TRUE;
          }
     }
     return FALSE;
}

/**
 * 创建新的调用方法,主要是把第一个参数替换了
 * *创建函数调用,如temp1->evaluate
 */
static tree createNewCall(tree call,location_t loc,tree varDecl,tree fieldDecl,tree firstParm)
{
        tree type=TREE_TYPE(call);
        tree ref = build1 (INDIRECT_REF, TREE_TYPE(TREE_TYPE(varDecl)), varDecl);
        tree fndecl=build3 (COMPONENT_REF, TREE_TYPE(fieldDecl),ref, fieldDecl, NULL_TREE);
        int nargs=call_expr_nargs (call);
        tree args[nargs];
        int i;
        for(i=0;i<nargs;i++){
            if(i==0)
                args[i]=firstParm;
            else
                args[i]=CALL_EXPR_ARG (call, i);
        }
        tree newCall=build_call_array_loc (loc, type,fndecl, nargs, args);
        return newCall;
}

static tree createVarDecl(tree varType,char *name,location_t loc)
{
    tree id=aet_utils_create_ident(name);
    tree varDecl=build_decl (loc, VAR_DECL, id, varType);
    DECL_INITIAL(varDecl)=null_pointer_node;
    DECL_CONTEXT(varDecl)=current_function_decl;
    TREE_USED (varDecl)=1;
    return varDecl;
}

/**
 * 生成({XXXX *varDecl=NULL;varDecl=modifyVar;varDecl->newCall();})
 * 如果newCall有返回值生成target_expr，否则生成bind_expr
 */
static tree createTargetExpr(tree type,tree varDecl,tree modifyVar,tree hideVarDecl,tree newCall,location_t loc)
{
    nboolean isCreateTarget=aet_utils_valid_tree(hideVarDecl);
    tree  stmtList = alloc_stmt_list ();
    tree stmt0 = build_stmt (loc, DECL_EXPR, void_type_node);
    append_to_statement_list_force (stmt0, &stmtList);
    tree modifyVarDecl= build2 (MODIFY_EXPR, void_type_node, varDecl, modifyVar);
    append_to_statement_list_force (modifyVarDecl, &stmtList);
    if(isCreateTarget){
        tree modifyExpr= build2 (MODIFY_EXPR, void_type_node, hideVarDecl, newCall);
        append_to_statement_list_force (modifyExpr, &stmtList);
    }else{
        append_to_statement_list_force (newCall, &stmtList);
    }
    tree bindExpr = build3 (BIND_EXPR, void_type_node, varDecl, stmtList, NULL);
    if(!isCreateTarget)
        return bindExpr;
    tree target = build4 (TARGET_EXPR, type, hideVarDecl,bindExpr, NULL_TREE, NULL_TREE);
    return target;
}

/**
 * getRandom()->nextInt();转成
 *  ({ARandom *varName=getRandom();varName->nextInt();});
 *  ARandom *varName=getRandom()是错的。不能给varName赋初始值，必须改成
 *  ({ARandom *varName;varName=getRandom();varName->nextInt();});
 */
static tree createTarget1(tree call)
{
    location_t loc=EXPR_LOCATION (call);
    tree rtnType=TREE_TYPE(call);//返回值类型
    nboolean hasRtn=(TREE_CODE(rtnType)!=VOID_TYPE);//调用是否有返回值

    tree componentRef= CALL_EXPR_FN (call);
    tree indirectRef=TREE_OPERAND(componentRef,0);
    tree fieldDecl=TREE_OPERAND(componentRef,1);
    tree callExpr=TREE_OPERAND(indirectRef,0);//getRandom()

     /* 隐藏的返回变量，返回值赋给该变量*/
    tree hideVarDecl=hasRtn?create_tmp_var_raw(rtnType):NULL_TREE;

    tree varType=build_pointer_type(TREE_TYPE(indirectRef));//ARandom *
    tree varDecl= createVarDecl(varType,"temp1",loc);

     /*创建函数调用,如temp1->evaluate*/
     tree newCall=createNewCall(call,loc,varDecl,fieldDecl,varDecl);
     return createTargetExpr(rtnType,varDecl,callExpr,hideVarDecl,newCall,loc);
}

/**
 *  ((AObject*) getRandom())->getooo();转成
 *  ({AObject *temp1=NULL; temp1=(AObject *)getRandom();temp1->getooo();});
 */
static tree createTarget2(tree call)
{
    location_t loc=EXPR_LOCATION (call);
    tree rtnType=TREE_TYPE(call);//返回值类型
    nboolean hasRtn=(TREE_CODE(rtnType)!=VOID_TYPE);//调用是否有返回值

    tree componentRef= CALL_EXPR_FN (call);
    tree indirectRef=TREE_OPERAND(componentRef,0);
    tree fieldDecl=TREE_OPERAND(componentRef,1);
    tree nopExpr=TREE_OPERAND(indirectRef,0);//(AObject*)getRandom()

     /* 隐藏的返回变量，返回值赋给该变量*/
     tree hideVarDecl=hasRtn?create_tmp_var_raw(rtnType):NULL_TREE;

     tree varType=build_pointer_type(TREE_TYPE(indirectRef));//AObject *
     tree varDecl= createVarDecl(varType,"temp1",loc);

     /*创建函数调用,如temp1->evaluate*/
     tree newCall=createNewCall(call,loc,varDecl,fieldDecl,varDecl);

     return createTargetExpr(rtnType,varDecl,nopExpr,hideVarDecl,newCall,loc);
}


/**
 * 类转接口的方式 RandomGenerator是接口 getRandom()返回类对象。
 *  ((RandomGenerator*) getRandom())->evaluate();转成
 *  ({RandomGenerator *iface=(RandomGenerator *)getRandom();iface->evaluate();});
 */

static tree createTarget3(tree call)
{
    location_t loc=EXPR_LOCATION (call);
    tree rtnType=TREE_TYPE(call);//返回值类型
    nboolean hasRtn=(TREE_CODE(rtnType)!=VOID_TYPE);//调用是否有返回值

    tree componentRefOne= CALL_EXPR_FN (call);
    tree componentRefTwo=TREE_OPERAND(componentRefOne,0);
    tree fieldDecl=TREE_OPERAND(componentRefOne,1);

     /* 隐藏的返回变量，返回值赋给该变量*/
    tree hideVarDecl=hasRtn?create_tmp_var_raw(rtnType):NULL_TREE;

    tree varRecordType=TREE_TYPE(componentRefTwo);
    tree varType=build_pointer_type(varRecordType);//RandomGenerator *
    tree varDecl= createVarDecl(varType,"temp1",loc);

     tree firstParm=CALL_EXPR_ARG (call, 0);
     tree cref0=TREE_OPERAND(firstParm,0);
     tree cref1=TREE_OPERAND(cref0,0);
     TREE_OPERAND(cref1,0)=build_indirect_ref(loc,varDecl,RO_ARROW);//varDecl;这里不能只接用varDecl
     tree newCall=createNewCall(call,loc,varDecl,fieldDecl,firstParm);
     /*相当于&getRandom()->ifaceRandomGenerator2066046634,getRandom在这里调用一次*/
     tree iface = build_unary_op (loc, ADDR_EXPR, componentRefTwo, FALSE);
     return createTargetExpr(rtnType,varDecl,iface,hideVarDecl,newCall,loc);
}

/*
 * 创建新的调用
 * 如:esdsbehx.nextInt();
 * nextInt的第一个参数是&firstParm
 */
static tree createNewDotCall(tree call,location_t loc,tree varDecl,tree fieldDecl,tree firstParm)
{
        tree type=TREE_TYPE(call);
        tree fndecl=build3 (COMPONENT_REF, TREE_TYPE(fieldDecl),varDecl, fieldDecl, NULL_TREE);
        int nargs=call_expr_nargs (call);
        tree args[nargs];
        int i;
        for(i=0;i<nargs;i++){
            if(i==0)
                args[i]=    build_unary_op (loc, ADDR_EXPR, firstParm, FALSE);
            else
                args[i]=CALL_EXPR_ARG (call, i);
        }
        tree newCall=build_call_array_loc (loc, type,fndecl, nargs, args);
        return newCall;
}

/**
 * getRandom().nextInt();
 */
static tree createTarget4(tree call)
{
//    tree args[1];
//    args[0]=varDecl;
//    tree fndecl=lookup_name(aet_utils_create_ident("printgen"));
//    tree add = build_unary_op (loc, ADDR_EXPR, fndecl, FALSE);
//    tree newCall=build_call_array_loc (loc, void_type_node,add, 1, args);
//    printf("createTarget3 printgen\n");
//    aet_print_tree(newCall);

    location_t loc=EXPR_LOCATION (call);
    tree rtnType=TREE_TYPE(call);//返回值类型
    nboolean hasRtn=(TREE_CODE(rtnType)!=VOID_TYPE);//调用是否有返回值


    tree componentRef= CALL_EXPR_FN (call);
    tree callExpr=TREE_OPERAND(componentRef,0);//getRandom();
    tree fieldDecl=TREE_OPERAND(componentRef,1);

    tree hideVarDecl=hasRtn?create_tmp_var_raw(rtnType):NULL_TREE;

    tree varType=TREE_TYPE(callExpr);//ARandom
    tree varDecl= createVarDecl(varType,"temp1",loc);

    tree newCall=createNewDotCall(call,loc,varDecl,fieldDecl,varDecl);
    return createTargetExpr(rtnType,varDecl,callExpr,hideVarDecl,newCall,loc);


}

/**
 * getRandom()->nextInt()---({ARandom *temp=getRandom();temp->nextInt(temp);})
 * call_expr
 *      -----> COMPONENT_REF
 *                    ------> INDIRECT_REF
 *                                ----------> CALL_EXPR
 * ((AObject*)getRandom())->getooo();//转类对象再调方法
 * ((RandomGenerator*)getRandom())->evaluate();转接口再调方法
 */
static tree processCallExpr(tree call)
{
   tree fn= CALL_EXPR_FN (call);
   if(TREE_CODE(fn)==COMPONENT_REF){
        tree op=TREE_OPERAND(fn,0);//indirect_ref中的TREE_OPERAND(op,0) 相当于getRandom()
        tree op1=TREE_OPERAND(fn,1);//相当于nextInt
        int model=getModel(op);
        if(model>0 && isFieldDecl(op1)){
              printf("处理有返回值和没有返回值 model:%d\n",model);
              aet_print_tree_skip_debug(call);
              tree target=call;
              if(model==1)
                  target=createTarget1(call); //getRandom()->nextInt()
              else if(model==2)
                  target=createTarget2(call); //((AObject*)getRandom())->getooo();
              else if(model==3)
                  target=createTarget3(call); //((RandomGenerator*)getRandom())->evaluate();
              else if(model==4)
                  target=createTarget4(call);//getRandom().nextInt();
              printf("bind over over\n");
              aet_print_tree(target);
              printf("bind over over cccccn");
              return target;
        }
   }
   return call;
}



/**
 * 判断call_expr是不是返回一个类对象
 */
static nboolean isReturnObject(tree call)
{
     tree type=TREE_TYPE(call);
     char *sysName=class_util_get_class_name(type);
     if(sysName!=NULL){
        return TRUE;
     }
     return FALSE;
}

/**
 * Abc *taa=getRandom();
 */

static tree createModify(tree call,int index,location_t loc)
{
    tree type=TREE_TYPE(call);
    char name[255];
    sprintf(name,"tempVarName_%d",index);
    tree varDecl= createVarDecl(type,name,loc);
    tree modifyVarDecl= build2 (MODIFY_EXPR, void_type_node, varDecl, call);
    printf("nameless_call_parser createModify ---- index:%d\n",index);
    aet_print_tree_skip_debug(modifyVarDecl);
    return modifyVarDecl;
}

typedef struct _NamelessBuffer{
    tree modifys[20];
    int count;
    tree fields[20];
    int fieldsCount;
}NamelessBuffer;

static tree getType(char *sysName,nboolean  pointer)
{
   ClassInfo *info=class_mgr_get_class_info(class_mgr_get(),sysName);
   if(info==NULL){
       n_error("在namelesscall.c 找不到类%s的classInfo",sysName);
   }
   return pointer?build_pointer_type(TREE_TYPE(info->recordTypeDecl)):TREE_TYPE(info->recordTypeDecl);

}
/**
 * 把varDec转成能引用fieldDec的类或接口
 */
static tree convertDest(location_t loc,tree varDecl,tree fieldDecl)
{
    tree varType=TREE_TYPE(varDecl);
    nboolean isPointer=TREE_CODE(varType)==POINTER_TYPE;
    char *sysName=class_util_get_class_name(varType);
    char *fieldSysName=class_util_get_class_name_from_field_decl(fieldDecl);
    if(!fieldSysName){
       aet_print_tree_skip_debug(fieldDecl);
       n_error("未知错误：请报告。");
    }
    ClassRelationship ship=class_mgr_relationship(class_mgr_get(),sysName,fieldSysName);
    printf("relation ship---- %d isPointer:%d\n",ship,isPointer);
    if(ship==CLASS_RELATIONSHIP_CHILD){//把varDecl转成fieldSysName
       //转成父类
       if(isPointer){
           tree parentType=  getType(fieldSysName,TRUE);
           varDecl = build1 (NOP_EXPR, parentType, varDecl);
       }else{
           tree add=build_unary_op (loc, ADDR_EXPR, varDecl, FALSE);
           tree parentType=  getType(fieldSysName,TRUE);
           varDecl = build1 (NOP_EXPR, parentType, add);
       }
    }
    return varDecl;
}

/**
 * 生成self参数
 */
static tree getSelfParm(tree varDecl,location_t loc)
{
           tree varType=TREE_TYPE(varDecl);
           nboolean isPointer=TREE_CODE(varType)==POINTER_TYPE;
           char *sysName=class_util_get_class_name(varType);
           ClassInfo *info=class_mgr_get_class_info(class_mgr_get(),sysName);
           tree firstParms=NULL_TREE;
           if(class_info_is_interface(info)){
               printf("createNewCall00 是一个接口 恢复实现它的类作为self参数\n");
               aet_print_tree(varDecl);
               if(TREE_CODE(varDecl)==COMPONENT_REF){
                   tree indirect=TREE_OPERAND (varDecl, 0);
                   tree indirectType=TREE_TYPE(varDecl);
                   nboolean pointer=TREE_CODE(indirectType)==POINTER_TYPE;
                   firstParms=pointer?indirect:build_unary_op (loc, ADDR_EXPR, indirect, FALSE);
                   return firstParms;
               }
               if(isPointer){
                   tree datum=build_indirect_ref (loc,varDecl,RO_ARROW);
                   tree id=aet_utils_create_ident(IFACE_COMMON_STRUCT_VAR_NAME);//
                   tree ref= build_component_ref (loc, datum,id, loc);
                   id=aet_utils_create_ident(IFACE_AT_CLASS);//
                   firstParms= build_component_ref (loc, ref,id, loc);
               }else{
                   tree id=aet_utils_create_ident(IFACE_COMMON_STRUCT_VAR_NAME);//
                   tree ref= build_component_ref (loc, varDecl,id, loc);
                   id=aet_utils_create_ident(IFACE_AT_CLASS);//
                   firstParms= build_component_ref (loc, ref,id, loc);
               }
           }else{
               firstParms=isPointer?varDecl:build_unary_op (loc, ADDR_EXPR, varDecl, FALSE);
           }
           return firstParms;
}

static tree createNewCall00(tree call,location_t loc,tree varDecl,tree fieldDecl)
{
        varDecl=convertDest(loc,varDecl,fieldDecl);
        tree varType=TREE_TYPE(varDecl);
        nboolean isPointer=TREE_CODE(varType)==POINTER_TYPE;
        tree firstParms=getSelfParm(varDecl,loc);
        if(!aet_utils_valid_tree(firstParms)){
            n_error("不能转换出第一个参数self\n");
        }
        tree type=TREE_TYPE(call);//返回值类型
        tree fndecl;
        int nargs=call_expr_nargs (call);
        tree args[nargs];
        int i;
        for(i=0;i<nargs;i++){
            if(i==0)
                args[i]=firstParms;
            else
                args[i]=CALL_EXPR_ARG (call, i);
        }
        printf("createNewCall00------isPointer:%d\n",isPointer);
        aet_print_tree(varDecl);
        printf("createNewCall00------\n");
        aet_print_tree(fieldDecl);
        if(isPointer){
            tree datum=build_indirect_ref (loc,varDecl,RO_ARROW);
            fndecl= build_component_ref (loc, datum,DECL_NAME(fieldDecl), loc);
        }else{
            fndecl = build_component_ref (loc, varDecl,DECL_NAME(fieldDecl), loc);
        }
        tree newCall=build_call_array_loc (loc, type,fndecl, nargs, args);
        return newCall;
}

static tree createLink(NamelessBuffer *bufs,tree lastVal,location_t loc)
{
    int i;
    tree value=lastVal;
    for(i=bufs->fieldsCount-1;i>0;i--){
        tree fieldDecl=bufs->fields[i];
        tree varType=TREE_TYPE(value);
        nboolean isPointer=TREE_CODE(varType)==POINTER_TYPE;
        if(isPointer){
           tree datum=build_indirect_ref (loc,value,RO_ARROW);
           value= build_component_ref (loc, datum,DECL_NAME(fieldDecl), loc);
        }else{
           value = build_component_ref (loc, value,DECL_NAME(fieldDecl), loc);
        }
    }
    return value;
}

static tree addDebug(tree modify,location_t loc)
{
        tree varDecl=TREE_OPERAND (modify, 0);
        tree type=TREE_TYPE(varDecl);
        if(TREE_CODE(type)!=POINTER_TYPE)
            varDecl = build_unary_op (loc, ADDR_EXPR, varDecl, FALSE);

        tree args[1];
        args[0]=varDecl;
        tree fndecl=lookup_name(aet_utils_create_ident("printgen"));
        tree add = build_unary_op (loc, ADDR_EXPR, fndecl, FALSE);
        tree newCall=build_call_array_loc (loc, void_type_node,add, 1, args);
        printf("addDebug printgen\n");
        return newCall;
}

static tree processXX(tree call)
{
    location_t loc=EXPR_LOCATION (call);
    tree rtnType=TREE_TYPE(call);//返回值类型
    nboolean hasRtn=(TREE_CODE(rtnType)!=VOID_TYPE);//调用是否有返回值

    tree hideVarDecl=hasRtn?create_tmp_var_raw(rtnType):NULL_TREE;

    tree  stmtList = alloc_stmt_list ();
    tree stmt0 = build_stmt (loc, DECL_EXPR, void_type_node);
    append_to_statement_list_force (stmt0, &stmtList);

    NamelessBuffer bufs;
    bufs.count=0;
    bufs.fieldsCount=0;

    tree fn= CALL_EXPR_FN (call);
    tree value=fn;
    tree last=NULL_TREE;
    while(true){
        int length = TREE_OPERAND_LENGTH (value);
        if(length<=0){
            printf("没有 TREE_OPERAND_LENGTH (value);\n");
            break;
        }
        if(TREE_CODE(value)==COMPONENT_REF){
            tree field=TREE_OPERAND (value, 1);
            bufs.fields[bufs.fieldsCount++]=field;
        }
        tree ref=TREE_OPERAND (value, 0);
        if(TREE_CODE(ref)==CALL_EXPR){
            nboolean isObject=isReturnObject(ref);
            if(isObject){
                tree modifyVarDecl=createModify(ref,bufs.count,loc);
                append_to_statement_list_force (modifyVarDecl, &stmtList);
                tree debugFunc=addDebug(modifyVarDecl,loc);
                append_to_statement_list_force (debugFunc, &stmtList);
                bufs.modifys[bufs.count]=modifyVarDecl;
                bufs.count++;
            }
        }
        value=ref;
    }
    tree firstVal=TREE_OPERAND (bufs.modifys[0], 0);
    tree lastVal=TREE_OPERAND (bufs.modifys[bufs.count-1], 0);
    tree firstField=bufs.fields[0];
    lastVal=createLink(&bufs,lastVal,loc);
    tree newCall= createNewCall00(call,loc,lastVal,firstField);
    tree modifyExpr= build2 (MODIFY_EXPR, void_type_node, hideVarDecl, newCall);
    append_to_statement_list_force (modifyExpr, &stmtList);
    tree bindExpr = build3 (BIND_EXPR, void_type_node, firstVal, stmtList, NULL);
    tree target = build4 (TARGET_EXPR, rtnType, hideVarDecl,bindExpr, NULL_TREE, NULL_TREE);
    return target;
}

/////////////////////////------------------------------------------------
static tree createModify_new(tree call,int index,location_t loc)
{
    tree type=TREE_TYPE(call);
    char name[255];
    sprintf(name,"tempVarName_%d",index);
    tree varDecl= createVarDecl(type,name,loc);
    tree modifyVarDecl= build2 (MODIFY_EXPR, void_type_node, varDecl, call);
    printf("nameless_call_parser createModify ---- index:%d\n",index);
    aet_print_tree_skip_debug(modifyVarDecl);
    return modifyVarDecl;
}

static int isAetCall(tree call)
{
    tree type=NULL_TREE;
    nboolean isFunc=FALSE;
    int result=0;
    if(TREE_CODE(call)==FUNCTION_DECL){
        type=TREE_TYPE(call);
        type=TREE_TYPE(type);//函数返回值
        isFunc=TRUE;
    }else if(TREE_CODE(call)==COMPONENT_REF){
        tree field=TREE_OPERAND (call, 1);
        type=TREE_TYPE(field);
        if(TREE_CODE(type)==POINTER_TYPE){
            type=TREE_TYPE(type);//函数返回值
            if(TREE_CODE(type)==FUNCTION_TYPE){
                type=TREE_TYPE(type);//函数返回值
                isFunc=TRUE;
            }
        }
    }
    char *sysName=class_util_get_class_name(type);
    nboolean isPointer=TREE_CODE(type)==POINTER_TYPE;
    if(sysName!=NULL && isFunc){
       result=isPointer?1:2;
    }
    return result;
}

static tree  getFuncOrFieldRtnType(tree call)
{
    tree type=NULL_TREE;
    if(TREE_CODE(call)==FUNCTION_DECL){
        type=TREE_TYPE(call);
        type=TREE_TYPE(type);//函数返回值
    }else if(TREE_CODE(call)==COMPONENT_REF){
        tree field=TREE_OPERAND (call, 1);
        type=TREE_TYPE(field);
        if(TREE_CODE(type)==POINTER_TYPE){
            type=TREE_TYPE(type);//函数返回值
            if(TREE_CODE(type)==FUNCTION_TYPE){
                type=TREE_TYPE(type);//函数返回值
            }
        }
    }
    return type;
}


static int generatorCallLink(tree value,NPtrArray *callLink)
{
        if(TREE_CODE(value)==FUNCTION_DECL){
            n_ptr_array_add(callLink,value);
        }else if(TREE_CODE(value)==CALL_EXPR){
            tree fn= CALL_EXPR_FN (value);
            n_ptr_array_add(callLink,value);
            return generatorCallLink(fn,callLink);
        }else if(TREE_CODE(value)==COMPONENT_REF){
            tree ref=TREE_OPERAND (value, 0);
            n_ptr_array_add(callLink,value);
            return generatorCallLink(ref,callLink);
        }else{
            int length = TREE_OPERAND_LENGTH (value);
            if(length>0){
                tree ref=TREE_OPERAND (value, 0);
                n_ptr_array_add(callLink,value);
                return generatorCallLink(ref,callLink);
            }
        }
        return 0;
}

/**
 * 通过function_decl找到调用者即call_expr
 */
static tree findCall(tree call,tree func,enum tree_code code)
{
   NPtrArray *array=n_ptr_array_new();
   generatorCallLink(call,array);
   int i;
   int pos=-1;
   for(i=0;i<array->len;i++){
       tree item=n_ptr_array_index(array,i);
       if(item==func){
           pos=i;
           break;
       }
   }
   for(i=pos;i>=0;i--){
         tree item=n_ptr_array_index(array,i);
         if(TREE_CODE(item)==code)
             return item;
   }
   n_ptr_array_unref(array);
   return NULL_TREE;
}

/**
 * var->getData();
 * oldCall存放的是参数
 */
static tree createCall(tree oldCall,tree valDecl,tree compref,location_t loc)
{
        tree varType= TREE_TYPE(valDecl);
        tree firstParms=valDecl;
        if(TREE_CODE(varType)!=POINTER_TYPE){
            firstParms= build_unary_op (loc, ADDR_EXPR, valDecl, FALSE);
        }
        tree type=TREE_TYPE(oldCall);//返回值类型
        tree fndecl;
        int nargs=call_expr_nargs (oldCall);
        tree args[nargs];
        int i;
        for(i=0;i<nargs;i++){
            if(i==0)
                args[i]=firstParms;
            else
                args[i]=CALL_EXPR_ARG (oldCall, i);
        }
        tree newCall=build_call_array_loc (loc, type,compref, nargs, args);
        return newCall;
}

static tree processComponentRef(tree varVal,tree oldCall,tree componentRef,location_t loc)
{
      tree type=TREE_TYPE(varVal);
      tree fieldDecl=TREE_OPERAND (componentRef, 1);
      tree newCompref=NULL_TREE;
      if(TREE_CODE(type)==POINTER_TYPE){
           tree datum=build_indirect_ref (loc,varVal,RO_ARROW);
           newCompref= build_component_ref (loc, datum,DECL_NAME(fieldDecl), loc);
      }else{
           newCompref = build_component_ref (loc, varVal,DECL_NAME(fieldDecl), loc);
      }
      tree newCall=createCall(oldCall,varVal,newCompref,loc);
      return newCall;
}

/**
 * 创建变量声明
 */
static tree createVarDeclStmt(tree rvalue,NamelessBuffer *bufs,location_t loc,tree *stmtList)
{
    tree modifyVarDecl=createModify_new(rvalue, bufs->count,loc);
    append_to_statement_list_force (modifyVarDecl, stmtList);
    tree debugFunc=addDebug(modifyVarDecl,loc);
    append_to_statement_list_force (debugFunc, stmtList);
    tree varVal=TREE_OPERAND (modifyVarDecl, 0);
    bufs->modifys[bufs->count]=modifyVarDecl;
    bufs->count++;
    return varVal;
}

static tree process(tree call)
{
    NPtrArray *array=n_ptr_array_new();
    char *link=NULL;
    class_util_get_nameless_call_link(call,array,&link);
    printf("process nameless 生成target 原来调用的链是:%s\n",link);

    location_t loc=EXPR_LOCATION (call);
    tree rtnType=TREE_TYPE(call);//返回值类型
    nboolean hasRtn=(TREE_CODE(rtnType)!=VOID_TYPE);//调用是否有返回值

    tree hideVarDecl=hasRtn?create_tmp_var_raw(rtnType):NULL_TREE;

    tree  stmtList = alloc_stmt_list ();
    tree stmt0 = build_stmt (loc, DECL_EXPR, void_type_node);
    append_to_statement_list_force (stmt0, &stmtList);

    NamelessBuffer bufs;
    bufs.count=0;
    bufs.fieldsCount=0;

    tree lastCall=NULL_TREE;
    int i;
    tree prevVal;
    for(i=array->len-1;i>=0;i--){
        tree item=n_ptr_array_index(array,i);
        int result=isAetCall(item);
        printf("生成target语句:isAetCall吗%d i:%d array->len:%d\n",result,i,array->len);
        aet_print_tree(item);
        if(result>0){
            if(TREE_CODE(item)==FUNCTION_DECL){
                tree ref=findCall(call,item,CALL_EXPR);
                prevVal=createVarDeclStmt(ref,&bufs,loc,&stmtList);
            }else if(TREE_CODE(item)==COMPONENT_REF){
                //用prevVal调和field
                tree callExpr=findCall(call,item,CALL_EXPR);//取参数
                tree newCall=processComponentRef(prevVal,callExpr,item,loc);
                printf("引用 COMPONENT_REF 生成函数调用call_expr i:%d\n",i);
                aet_print_tree(newCall);
                if(i!=0){
                    prevVal=createVarDeclStmt(newCall,&bufs,loc,&stmtList);
                }else{
                    lastCall=newCall;
                }
            }
        }else{
            if(TREE_CODE(item)==COMPONENT_REF){
                 tree callExpr=findCall(call,item,CALL_EXPR);//取参数
                 tree newCall=processComponentRef(prevVal,callExpr,item,loc);
                 printf("引用 COMPONENT_REF 但返回值不是类 call_expr i:%d\n",i);
                 aet_print_tree(newCall);
                 if(i!=0){
                     n_error("还未处理此种情况。-----i:%d\n",i);
                 }else{
                     lastCall=newCall;
                 }
            }
        }
    }

    tree firstVal=TREE_OPERAND (bufs.modifys[0], 0);
    tree modifyExpr= build2 (MODIFY_EXPR, void_type_node, hideVarDecl, lastCall);
    append_to_statement_list_force (modifyExpr, &stmtList);
    tree bindExpr = build3 (BIND_EXPR, void_type_node, firstVal, stmtList, NULL);
    tree target = build4 (TARGET_EXPR, rtnType, hideVarDecl,bindExpr, NULL_TREE, NULL_TREE);
    return target;
}

tree nameless_call_parser(NamelessCall *self,tree call)
{
   c_parser *parser=self->parser;
   if(TREE_CODE(call)!=COMPONENT_REF && TREE_CODE(call)!=CALL_EXPR)
       return call;
   c_token *token=c_parser_peek_token (parser);
   if(token->type==CPP_DOT || token->type==CPP_DEREF){
       return call;
   }
   int hasNamelessCall= class_util_has_nameless_call(call);
   if(hasNamelessCall==0)
       return call;
   printf("nameless_call_parser --00-- %d\n",hasNamelessCall);
   aet_print_tree_skip_debug(call);
   tree result=process(call);
   printf("nameless_call_parser --11-- %d\n",hasNamelessCall);
   aet_print_tree_skip_debug(result);
   return result;
}


void  nameless_call_set_parser(NamelessCall *self,c_parser *parser)
{
	 self->parser=parser;
}

NamelessCall *nameless_call_get()
{
	static NamelessCall *singleton = NULL;
	if (!singleton){
		 singleton =n_slice_alloc0 (sizeof(NamelessCall));
		 namelessCallInit(singleton);
	}
	return singleton;
}


